description: Preserve the canonical Deed Sales Order, delivery, invoice and payment workflow
globs:
  - "components/modules/Sales.tsx"
  - "components/modules/InvoiceDetail.tsx"
  - "lib/store.tsx"
  - "lib/odoo-sales-flow.ts"
