# ─────────────────────────────────────────────────────────────────
# DEED ERP — PRODUCTION ENVIRONMENT FILE
# Copy this file to your server as:  ~/deed-erp/.env
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED: Authentication ──────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_openssl_rand_output
NEXTAUTH_SECRET=REPLACE_WITH_SAME_SECRET_AS_ABOVE
CUSTOMER_PORTAL_SECRET=REPLACE_WITH_ANOTHER_openssl_rand_output

# ── REQUIRED: Privileged-role MFA ───────────────────────────────
# Generate each secret independently with: openssl rand -base64 48
MFA_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_output
MFA_CHALLENGE_SECRET=REPLACE_WITH_ANOTHER_openssl_rand_output
# Enable only after both secrets are provisioned. Production security closure
# requires this to be true; Director, Admin Officer and Finance Officer then
# cannot receive an ERP session without a valid authenticator code.
MFA_ENFORCE_PRIVILEGED=true

# One-time first-install bootstrap only. Remove from production after the first
# director account exists.
# SETUP_ADMIN_SECRET=

# ── REQUIRED: Database ───────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use a dedicated non-superuser application role. Bind PostgreSQL to localhost
# or an explicitly private network; never expose 5432 directly to the Internet.
DATABASE_URL=postgresql://REPLACE_WITH_DB_USER:REPLACE_WITH_DB_PASSWORD@localhost:5432/deed_erp
POSTGRES_URL=postgresql://REPLACE_WITH_DB_USER:REPLACE_WITH_DB_PASSWORD@localhost:5432/deed_erp

# ── REQUIRED: App URL ────────────────────────────────────────────
# Use your server IP or domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://REPLACE_WITH_YOUR_DOMAIN
NEXTAUTH_URL=https://REPLACE_WITH_YOUR_DOMAIN
# ── REQUIRED: Internal API Secret ───────────────────────────────
# Generate with:  openssl rand -base64 24
INTERNAL_API_SECRET=REPLACE_WITH_openssl_rand_output

# ── App Environment ──────────────────────────────────────────────
NODE_ENV=production

# ── Company Info (shown on PDFs & portal pages) ──────────────────
PDF_COMPANY_NAME=Deed Technologies Limited
PDF_COMPANY_ADDRESS=Sanlam House, Nairobi
PDF_COMPANY_PHONE=+254 113704451
PDF_COMPANY_EMAIL=info@deed.co.ke
PDF_LOGO_URL=/deed-logo.png

NEXT_PUBLIC_COMPANY_NAME=Deed Technologies Limited
NEXT_PUBLIC_COMPANY_ADDRESS=Sanlam House, Nairobi
NEXT_PUBLIC_COMPANY_PHONE=+254 113704451
NEXT_PUBLIC_COMPANY_EMAIL=info@deed.co.ke

# ── Notification Routing ─────────────────────────────────────────
SALES_TEAM_EMAIL=sales@deed.co.ke
PROCUREMENT_TEAM_PHONE=+254113407964

# ─────────────────────────────────────────────────────────────────
# OPTIONAL INTEGRATIONS — leave blank if not using
# ─────────────────────────────────────────────────────────────────

# ── Email Provider (pick ONE: sendgrid | ses | smtp) ─────────────
# Required for: RFQ mail, sales quotes, invoices, user credentials, portal notices.
EMAIL_PROVIDER=smtp
EMAIL_FROM=info@deed.co.ke

# SendGrid
SENDGRID_API_KEY=

# AWS SES
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# SMTP (e.g. Contabo / cPanel / Zoho / Google Workspace)
SMTP_HOST=mail.deed.co.ke
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@deed.co.ke
SMTP_PASS=REPLACE_WITH_YOUR_PASSWORD

# Role-specific From + Reply-To (mailboxes must exist in cPanel).
# Auth uses *_SMTP_USER/PASS when set; otherwise authenticates as the
# department address with SMTP_PASS (same password as hello@ is fine).
HR_EMAIL=hr@deed.co.ke
# Leave apply: To HR_TEAM_EMAIL, CC Edwin + Dennis only (LEAVE_APPLY_CC_EMAILS).
HR_TEAM_EMAIL=hr@deed.co.ke
LEAVE_APPLY_CC_EMAILS=edwin@deed.co.ke,dennis@deed.co.ke
SALES_EMAIL=sales@deed.co.ke
ACCOUNTS_EMAIL=accounts@deed.co.ke
# Optional dedicated logins (recommended if passwords differ from SMTP_PASS):
# HR_SMTP_USER=hr@deed.co.ke
# HR_SMTP_PASS=
# SALES_SMTP_USER=sales@deed.co.ke
# SALES_SMTP_PASS=
# Sales inbox → CRM leads (IMAP). Defaults to SALES_SMTP_* + SMTP_HOST:993.
# SALES_IMAP_HOST=mail.deed.co.ke
# SALES_IMAP_PORT=993
# SALES_IMAP_USER=sales@deed.co.ke
# SALES_IMAP_PASS=
# CRON_SECRET=
# ACCOUNTS_SMTP_USER=accounts@deed.co.ke
# ACCOUNTS_SMTP_PASS=

# ── WhatsApp Business API ────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Twilio (SMS) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── Google Calendar Integration ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://REPLACE_WITH_YOUR_SERVER_IP_OR_DOMAIN/api/auth/google/callback

# ── AI Receipt Scanning (Anthropic) ─────────────────────────────
JARVIS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
DEED_WEBSITE_URL=https://deed.africa

# ── Rate Limiting (Upstash Redis) ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Partner public API CORS (comma-separated origins; empty = deny browser CORS)
PARTNER_CORS_ORIGINS=


# ── Durable Notification Platform ────────────────────────────────
# Protect /api/cron/notifications. Generate a long random value.
CRON_SECRET=

# Browser Web Push. Generate with: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@deed.co.ke

# Default phone normalization for local numbers.
DEFAULT_PHONE_COUNTRY_CODE=254

# Provider delivery webhooks.
# Meta WhatsApp GET verification token + POST app-secret signature.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Pin/update the Graph API version deliberately during provider maintenance.
WHATSAPP_GRAPH_API_VERSION=v18.0
WHATSAPP_HTTP_TIMEOUT_MS=10000
WHATSAPP_CIRCUIT_FAILURE_THRESHOLD=5
WHATSAPP_CIRCUIT_COOLDOWN_MS=60000

# SendGrid Event Webhook: use signed verification when available.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Optional shared-secret fallback for SendGrid webhook verification.
NOTIFICATION_WEBHOOK_SECRET=

# SMTP transport hardening.
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_RATE_DELTA_MS=1000
SMTP_RATE_LIMIT=8
# Optional when SMTP certificate hostname differs intentionally:
SMTP_TLS_SERVERNAME=

# SMS / bulk delivery controls.
TWILIO_HTTP_TIMEOUT_MS=10000
SMS_MAX_CONCURRENT=2
SMS_MAX_PER_SECOND=1
NOTIFICATION_BATCH_CONCURRENCY=4
