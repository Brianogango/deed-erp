generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  name               String
  passwordHash       String
  role               String   // e.g., "admin_officer", "sales_rep"
  modules            String[] // Array of accessible module IDs
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee           Employee?
}

model Employee {
  id                 String   @id @default(uuid())
  employeeNo         String   @unique
  fullName           String
  email              String   @unique
  phone              String
  nationalId         String   @unique
  kraPin             String   @unique
  jobTitle           String
  startDate          DateTime
  status             String   // "active", "on_leave", "exited"
  basicSalary        Float
  housingAllowance   Float
  transportAllowance Float
  bankAccount        String
  
  user               User?    @relation(fields: [userId], references: [id])
  userId             String?  @unique
  
  departmentId       String?
  createdAt          DateTime @default(now())
}

model Product {
  id              String   @id @default(uuid())
  name            String
  sku             String   @unique
  barcode         String?
  category        String
  salePrice       Float
  costPrice       Float
  taxRate         Float    @default(16)
  minStock        Int      @default(5)
  unit            String   @default("pcs")
  description     String?
  canBeSold       Boolean  @default(true)
  canBePurchased  Boolean  @default(true)
  isActive        Boolean  @default(true)
  requiresSerial  Boolean  @default(false)
  saleAccountCode String?
  costAccountCode String?
  
  serials         SerialNumber[]
  createdAt       DateTime @default(now())
}

model SerialNumber {
  id           String   @id @default(uuid())
  serial       String   @unique
  barcode      String?
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  location     String   // "warehouse", "shop", "customer"
  status       String   // "available", "sold", "under_repair"
  receivedDate DateTime @default(now())
  soldDate     DateTime?
  specs        String?
}

model SaleOrder {
  id              String   @id @default(uuid())
  ref             String   @unique
  status          String   // "quotation", "confirmed", "delivered", "invoiced", "cancelled"
  customerId      String
  customerName    String
  date            DateTime
  validUntil      DateTime?
  subtotal        Float
  taxTotal        Float
  total           Float
  notes           String?
  deliveryId      String?
  invoiceId       String?
  createdByUserId String?
  createdByName   String?
  savedAt         DateTime?
  createdAt       DateTime @default(now())

  lines           SaleOrderLine[]
}

model SaleOrderLine {
  id             String    @id @default(uuid())
  saleOrderId    String
  saleOrder      SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productId      String
  productName    String
  qty            Int
  unitPrice      Float
  discount       Float     @default(0)
  taxRate        Float     @default(0)
  subtotal       Float
  serialIds      String[]
  sourceLocation String?
  accountCode    String?
}

model Invoice {
  id          String   @id @default(uuid())
  ref         String   @unique
  type        String   // "customer_invoice", "vendor_bill"
  status      String   // "draft", "posted", "paid"
  partnerId   String
  partnerName String
  date        DateTime
  dueDate     DateTime
  subtotal    Float    @default(0)
  taxTotal    Float    @default(0)
  total       Float
  amountPaid  Float    @default(0)
  saleOrderId     String?
  purchaseOrderId String?
  receiptId       String?
  notes           String?

  lines       InvoiceLine[]
}

model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Int
  unitPrice   Float
  taxRate     Float
  subtotal    Float
  productId   String?
  accountCode String?
}

model Payment {
  id             String   @id @default(uuid())
  ref            String   @unique
  customerId     String
  customerName   String
  amount         Float
  method         String
  status         String
  reference      String
  receiptNumber  String
  receivedBy     String
  receivedDate   DateTime
  clearedDate    DateTime?
  accountingDate DateTime
  notes          String?

  invoices       PaymentAllocation[]
}

model PaymentAllocation {
  id              String  @id @default(uuid())
  paymentId       String
  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoiceRef      String
  amountAllocated Float
}

model Contact {
  id                 String   @id @default(uuid())
  type               String   // "individual" | "company"
  name               String
  tradingName        String?
  registrationNumber String?
  vatNumber          String?
  idNumber           String?
  jobTitle           String?
  companyId          String?
  email              String
  phone              String
  mobile             String?
  website            String?
  address            String
  postalAddress      String?
  city               String?
  country            String?
  isCustomer         Boolean  @default(false)
  isVendor           Boolean  @default(false)
  industry           String?
  tags               String[]
  creditLimit        Float?
  paymentTermsDays   Int?
  paymentTerms       String?
  bankName           String?
  bankAccount        String?
  bankBranch         String?
  bankDetails        String?
  notes              String?
  vendorRating       Float?
  loyaltyPoints      Int?     @default(0)
  createdAt          DateTime @default(now())
}

model PurchaseOrder {
  id           String   @id @default(uuid())
  ref          String   @unique
  status       String   // "draft", "sent", "confirmed", "partial", "received", "cancelled"
  vendorId     String
  vendorName   String
  date         DateTime
  expectedDate DateTime
  subtotal     Float
  taxTotal     Float
  total        Float
  billId       String?
  notes        String?
  receiptIds   String[]

  lines        POLine[]
  receipts     Receipt[]
}

model POLine {
  id              String   @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  qty             Int
  qtyReceived     Int      @default(0)
  unitPrice       Float
  taxRate         Float
  subtotal        Float
  requiresSerial  Boolean  @default(false)
  importedSerials String[]
  specs           String?
  accountCode     String?
}

model Receipt {
  id                  String   @id @default(uuid())
  ref                 String   @unique
  poId                String
  purchaseOrder       PurchaseOrder @relation(fields: [poId], references: [id])
  poRef               String
  vendorId            String
  vendorName          String
  status              String   // "draft", "validated"
  date                DateTime
  destinationLocation String
  billId              String?

  lines               ReceiptLine[]
}

model ReceiptLine {
  id              String   @id @default(uuid())
  receiptId       String
  receipt         Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  qtyExpected     Int
  qtyReceived     Int
  serials         String[]
  requiresSerial  Boolean  @default(false)
  importedSerials String[]
  specs           String?
}

model Opportunity {
  id                String   @id @default(uuid())
  ref               String   @unique
  name              String
  leadScore         Float?
  companyId         String
  companyName       String
  contactPersonId   String
  contactPersonName String
  ownerId           String
  ownerName         String
  stage             String
  probability       Float
  expectedValue     Float
  actualValue       Float    @default(0)
  createdDate       DateTime @default(now())
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  lastActivityDate  DateTime?
  leadSource        String
  campaign          String?
  description       String?
  customerNeeds     String?
  competitorInfo    String?
  lostReason        String?
  lostToCompetitor  String?
  tags              String[]
  notes             String?

  quotes            Quote[]
  activities        OpportunityActivity[]
}

model OpportunityActivity {
  id              String   @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type            String
  subject         String
  description     String?
  outcome         String?
  createdBy       String
  createdByName   String
  createdDate     DateTime @default(now())
  scheduledDate   DateTime?
  completedDate   DateTime?
  status          String
}

model Quote {
  id                String   @id @default(uuid())
  ref               String   @unique
  version           Int      @default(1)
  status            String
  opportunityId     String?
  opportunity       Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  opportunityName   String?
  companyId         String
  companyName       String
  contactPersonId   String
  contactPersonName String
  createdBy         String
  createdByName     String
  ownerId           String
  ownerName         String
  issueDate         DateTime @default(now())
  validUntil        DateTime?
  subtotal          Float
  discountAmount    Float    @default(0)
  discountPercent   Float    @default(0)
  taxTotal          Float
  total             Float
  paymentTerms      String?
  deliveryTerms     String?
  warranty          String?
  sentDate          DateTime?
  viewedDate        DateTime?
  viewCount         Int      @default(0)
  acceptedDate      DateTime?
  rejectedDate      DateTime?
  rejectionReason   String?
  saleOrderId       String?
  convertedDate     DateTime?
  parentQuoteId     String?
  revisionNotes     String?
  notes             String?
  internalNotes     String?
  terms             String?

  lines             QuoteLineItem[]
}

model QuoteLineItem {
  id              String   @id @default(uuid())
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  sku             String?
  description     String?
  qty             Int
  unit            String
  listPrice       Float
  unitPrice       Float
  discount        Float    @default(0)
  discountAmount  Float    @default(0)
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  subtotal        Float
  lineTotal       Float
  notes           String?
}