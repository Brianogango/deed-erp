// ── Delivery ───────────────────────────────────────────────────────────────────

// NOTE: this model (and DeliveryNoteItem below) was discovered to already
// exist on the Contabo production database with several columns never
// reflected here — created out-of-band ahead of this schema, evidently as
// part of a prior, uncommitted attempt at the same deliveries dual-write
// this file's mirror (lib/delivery-mirror.ts) now implements. All fields
// below are transcribed from the ACTUAL production DDL (pg_dump), not
// invented — including nullability that differs from what a fresh design
// would choose (e.g. clientId/createdById are nullable in production).
model DeliveryNote {
  id           String  @id @default(uuid()) @db.Uuid
  // deed_deliveries blob id this row mirrors — lets the dual-write be an
  // idempotent upsert instead of deleteMany+create (keeps id stable across
  // mirror passes). Null for any DeliveryNote created directly in Prisma.
  blobId       String? @unique @map("blob_id") @db.VarChar(80)
  dnNumber     String  @unique @map("dn_number") @db.VarChar(30)
  // Scalar FK (in addition to the existing implicit "DeliveryNoteSaleOrders"
  // M2M) — the blob model is one delivery per one sale order, so a direct
  // column supports the common "this delivery's SO" lookup without a join
  // table round-trip.
  saleOrderId  String? @map("sale_order_id") @db.Uuid
  // Nullable: real flow is Confirm SO → Delivery → Invoice. Requiring an
  // invoice blocked Prisma cutover from the deed_deliveries blob.
  invoiceId    String? @map("invoice_id") @db.Uuid
  clientId     String? @map("client_id") @db.Uuid
  saleOrderRef String? @map("sale_order_ref") @db.VarChar(40)
  customerName String? @map("customer_name") @db.VarChar(200)
  // Actual column is a plain VARCHAR in production, not the delivery_method
  // enum type (which exists but was never applied to this column).
  deliveryMethod          String    @default("pickup") @map("delivery_method") @db.VarChar(30)
  status                  String    @default("waiting") @db.VarChar(30)
  dispatchDate            DateTime? @map("dispatch_date") @db.Date
  deliveryDate            DateTime? @map("delivery_date") @db.Date
  courierName             String?   @map("courier_name") @db.VarChar(100)
  trackingNumber          String?   @map("tracking_number") @db.VarChar(80)
  deliveryAddress         String?   @map("delivery_address")
  recipientName           String?   @map("recipient_name") @db.VarChar(150)
  recipientPhone          String?   @map("recipient_phone") @db.VarChar(20)
  recipientIdNumber       String?   @map("recipient_id_number") @db.VarChar(40)
  signatureUrl            String?   @map("signature_url")
  notes                   String?
  warrantyCreated         Boolean   @default(false) @map("warranty_created")
  backorderOfId           String?   @map("backorder_of_id") @db.Uuid
  backorderOfRef          String?   @map("backorder_of_ref") @db.VarChar(40)
  preparedAt              DateTime? @map("prepared_at")
  preparedById            String?   @map("prepared_by") @db.Uuid
  deliveryNoteGeneratedAt DateTime? @map("delivery_note_generated_at")
  deliveryNoteGeneratedById String? @map("delivery_note_generated_by") @db.Uuid
  dispatchedById          String?   @map("dispatched_by") @db.Uuid
  createdById             String?   @map("created_by") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  invoice               Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  saleOrder             SaleOrder?         @relation("DeliveryNoteSaleOrder", fields: [saleOrderId], references: [id], onDelete: SetNull)
  client                Client?            @relation(fields: [clientId], references: [id])
  dispatchedBy          User?              @relation("DeliveryDispatcher", fields: [dispatchedById], references: [id])
  createdBy             User?              @relation("DeliveryCreator", fields: [createdById], references: [id])
  preparedBy            User?              @relation("DeliveryPreparer", fields: [preparedById], references: [id])
  deliveryNoteGeneratedBy User?            @relation("DeliveryNoteGenerator", fields: [deliveryNoteGeneratedById], references: [id])
  items                 DeliveryNoteItem[]
  saleOrders            SaleOrder[]        @relation("DeliveryNoteSaleOrders")
  outboundRelease        OutboundRelease?  @relation("OrcDelivery")

  @@index([clientId], map: "idx_delivery_notes_client")
  @@index([saleOrderId], map: "idx_delivery_notes_sale_order")
  @@index([status], map: "idx_delivery_notes_status")
  @@map("delivery_notes")
}

model DeliveryNoteItem {
  id             String   @id @default(uuid()) @db.Uuid
  dnId           String   @map("dn_id") @db.Uuid
  invoiceItemId  String?  @map("invoice_item_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  serialNumberId String?  @map("serial_number_id") @db.Uuid
  description    String?
  productName    String?  @map("product_name") @db.VarChar(200)
  qty            Int      @default(0)
  // Actually-shipped qty this line, distinct from `qty` (ordered/demanded).
  // The blob's delivery lines track qtyDone separately from qty (partial
  // delivery / backorder support).
  qtyDone        Int      @default(0) @map("qty_done")
  qtyReturned    Int      @default(0) @map("qty_returned")
  // Full multi-serial list for this line (as text, not FK'd) — blob lines
  // can carry several serials per line; serialNumberId above only ever
  // holds the first one, matching how SaleOrderItem also only tracks one.
  serialIds      String[] @default([]) @map("serial_ids")
  sourceLocation String?  @map("source_location") @db.VarChar(40)
  lineOrder      Int      @default(0) @map("line_order")

  deliveryNote DeliveryNote  @relation(fields: [dnId], references: [id], onDelete: Cascade)
  invoiceItem  InvoiceItem?  @relation(fields: [invoiceItemId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id])

  @@map("delivery_note_items")
}

// ── Repairs ────────────────────────────────────────────────────────────────────

model Repair {
  id                String       @id @default(uuid()) @db.Uuid
  jobNumber         String       @unique @map("job_number") @db.VarChar(30)
  clientId          String       @map("client_id") @db.Uuid
  assignedToId      String?      @map("assigned_to") @db.Uuid
  status            RepairStatus @default(intake)
  deviceType        String       @map("device_type") @db.VarChar(80)
  deviceBrand       String?      @map("device_brand") @db.VarChar(80)
  deviceModel       String?      @map("device_model") @db.VarChar(100)
  serialNumber      String?      @map("serial_number") @db.VarChar(100)
  imei              String?      @db.VarChar(30)
  reportedFault     String       @map("reported_fault")
  observedFault     String?      @map("observed_fault")
  conditionOnIntake String?      @map("condition_on_intake")
  accessoriesIn     String[]     @map("accessories_in")
  accessoriesNotes  String?      @map("accessories_notes")
  unlockCode        String?      @map("unlock_code") @db.VarChar(100)
  estimatedCost     Decimal?     @map("estimated_cost") @db.Decimal(14, 2)
  labourCost        Decimal      @default(0) @map("labour_cost") @db.Decimal(14, 2)
  partsCost         Decimal      @default(0) @map("parts_cost") @db.Decimal(14, 2)
  // totalCost = labourCost + partsCost — compute in application
  invoiceId         String?      @map("invoice_id") @db.Uuid
  intakeDate        DateTime     @default(now()) @map("intake_date")
  promisedDate      DateTime?    @map("promised_date") @db.Date
  completedDate     DateTime?    @map("completed_date")
  collectedDate     DateTime?    @map("collected_date")
  warrantyDays      Int?         @default(30) @map("warranty_days")
  warrantyExpiry    DateTime?    @map("warranty_expiry") @db.Date
  resolutionNotes   String?      @map("resolution_notes")
  conditionOnRelease String?     @map("condition_on_release")
  isUnrepairable    Boolean      @default(false) @map("is_unrepairable")
  priority          String       @default("normal") @db.VarChar(20)
  source            String       @default("walkin") @db.VarChar(30)
  referredById      String?      @map("referred_by") @db.Uuid
  notes             String?
  createdById       String       @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  client      Client                      @relation("RepairClient", fields: [clientId], references: [id])
  assignedTo  User?                       @relation("RepairTech", fields: [assignedToId], references: [id])
  invoice     Invoice?                    @relation("RepairInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  referredBy  Client?                     @relation("RepairReferrer", fields: [referredById], references: [id])
  createdBy   User                        @relation("RepairCreator", fields: [createdById], references: [id])
  stages          RepairStage[]
  parts           RepairPart[]
  diagnostics     RepairDiagnostic[]
  comms           RepairClientCommunication[]
  invoices        Invoice[]                   @relation("InvoiceRepair")
  outboundRelease OutboundRelease?            @relation("OrcRepair")

  @@index([clientId], map: "idx_repairs_client")
  @@index([status], map: "idx_repairs_status")
  @@index([assignedToId], map: "idx_repairs_technician")
  @@index([jobNumber], map: "idx_repairs_job_number")
  @@index([status, createdAt], map: "idx_repairs_status_created")
  @@map("repairs")
}

model RepairStage {
  id          String       @id @default(uuid()) @db.Uuid
  repairId    String       @map("repair_id") @db.Uuid
  status      RepairStatus
  notes       String?
  changedById String       @map("changed_by") @db.Uuid
