model ReconfigurationInstallationLine {
  id                      String            @id @default(uuid()) @db.Uuid
  workOrderId             String            @map("work_order_id") @db.Uuid
  componentProductId      String            @map("component_product_id") @db.Uuid
  requiredSpec            Json              @default("{}") @map("required_spec")
  selectedSerialId        String?           @map("selected_serial_id") @db.Uuid
  selectedSerialText      String?           @map("selected_serial_text") @db.VarChar(120)
  sourceLocation          String            @default("warehouse") @map("source_location") @db.VarChar(30)
  quantity                Int               @default(1)
  unitCost                Decimal           @default(0) @map("unit_cost") @db.Decimal(14, 2)
  targetSlotType          ComponentSlotType @map("target_slot_type")
  targetSlotNumber        Int               @default(1) @map("target_slot_number")
  // rsv_rcf_<work-order-uuid>_<line-uuid> is 8+36+1+36 = 81 chars — VarChar(80)
  // silently overflowed on every single reserve call ("Internal server error").
  reservationId           String?           @map("reservation_id") @db.VarChar(120)
  reservationStatus       String            @default("none") @map("reservation_status") @db.VarChar(20)
  compatibilityResult     String            @default("pending") @map("compatibility_result") @db.VarChar(20)
  installedAt             DateTime?         @map("installed_at")
  installedById           String?           @map("installed_by") @db.Uuid
  resultingInstallationId String?           @map("resulting_installation_id") @db.Uuid
  stockMoveRef            String?           @map("stock_move_ref") @db.VarChar(80)
  createdAt               DateTime          @default(now()) @map("created_at")

  workOrder             ReconfigurationWorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  componentProduct      Product                      @relation(fields: [componentProductId], references: [id])
  selectedSerial        SerialNumber?                @relation(fields: [selectedSerialId], references: [id])
  installedBy           User?                        @relation(fields: [installedById], references: [id])
  resultingInstallation DeviceComponentInstallation? @relation(fields: [resultingInstallationId], references: [id])

  @@index([workOrderId], map: "idx_rcf_install_wo")
  @@map("reconfiguration_installation_lines")
}

