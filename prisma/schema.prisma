  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@map("stock_adjustment_items")
}

// ── Purchases ──────────────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  poNumber        String              @unique @map("po_number") @db.VarChar(30)
  // Legacy vendor FK — the Supplier table was never actually adopted by any
  // live code path (Purchasing's vendor concept is Client.isVendor, the same
  // one vendor bills use). Left nullable/unused rather than dropped, so no
  // schema churn is needed if a future migration wants to reconcile the two.
  supplierId      String?             @map("supplier_id") @db.Uuid
  // The vendor this PO is actually against — Client, not Supplier.
  clientId        String?             @map("client_id") @db.Uuid
  status          PurchaseOrderStatus @default(draft)
  orderDate       DateTime            @default(now()) @map("order_date") @db.Date
  expectedDate    DateTime?           @map("expected_date") @db.Date
  deliveryAddress String?             @map("delivery_address")
  subtotal        Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 2)
  discountAmount  Decimal             @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount     Decimal             @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid      Decimal             @default(0) @map("amount_paid") @db.Decimal(14, 2)
  notes           String?
  internalNotes   String?             @map("internal_notes")
  approvedById    String?             @map("approved_by") @db.Uuid
  approvedAt      DateTime?           @map("approved_at")
  lockVersion     Int                 @default(0) @map("lock_version")
  createdById     String              @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  vendor           Client?             @relation("ClientPurchaseOrders", fields: [clientId], references: [id])
  approvedBy       User?               @relation("POApprover", fields: [approvedById], references: [id])
  createdBy        User                @relation("POCreator", fields: [createdById], references: [id])
  items            PurchaseOrderItem[]
  grns             GoodsReceivedNote[]
  supplierPayments SupplierPayment[]
  inventoryBatches InventoryBatch[]
  invoices         Invoice[]           @relation("PurchaseOrderInvoices")

  @@index([clientId], map: "idx_purchase_orders_client")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  poId        String   @map("po_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  description String?
  qtyOrdered  Int      @map("qty_ordered")
  qtyReceived Int      @default(0) @map("qty_received")
  qtyBilled   Int      @default(0) @map("qty_billed")
  unitCost    Decimal  @map("unit_cost") @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(14, 2)
  // Cost account override for GL posting (e.g. '6101') — client-side POLine.accountCode.
  accountCode String?  @map("account_code") @db.VarChar(20)
  notes       String?

  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
  grnItems GrnItem[]

  @@map("purchase_order_items")
}

model GoodsReceivedNote {
  id                String   @id @default(uuid()) @db.Uuid
  grnNumber         String   @unique @map("grn_number") @db.VarChar(30)
  poId              String   @map("po_id") @db.Uuid
  receivedDate      DateTime @default(now()) @map("received_date") @db.Date
  supplierInvoiceNo String?  @map("supplier_invoice_no") @db.VarChar(60)
  notes             String?
  createdById       String   @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  po        PurchaseOrder @relation(fields: [poId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     GrnItem[]

  @@map("goods_received_notes")
}

model GrnItem {
  id            String   @id @default(uuid()) @db.Uuid
  grnId         String   @map("grn_id") @db.Uuid
  poItemId      String   @map("po_item_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  qtyReceived   Int      @map("qty_received")
  unitCost      Decimal  @map("unit_cost") @db.Decimal(14, 2)
  conditionNote String?  @map("condition_note")
  serialNumbers String[] @map("serial_numbers")

  grn     GoodsReceivedNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem  PurchaseOrderItem   @relation(fields: [poItemId], references: [id])
  product Product             @relation(fields: [productId], references: [id])
  serials SerialNumber[]      @relation("SerialGrnItem")
  inventoryBatches InventoryBatch[]

  @@map("grn_items")
}

model SupplierPayment {
  id            String        @id @default(uuid()) @db.Uuid
  poId          String        @map("po_id") @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  amountBase    Decimal       @default(0) @map("amount_base") @db.Decimal(14, 2)
  paymentType   String        @default("customer_receipt") @map("payment_type") @db.VarChar(30)
  partnerId     String?       @map("partner_id") @db.Uuid
  bankAccountId String?       @map("bank_account_id") @db.Uuid
  journalId     String?       @map("journal_id") @db.Uuid
  currencyCode  String        @default("KES") @map("currency_code") @db.VarChar(3)
  exchangeRateToBase Decimal  @default(1) @map("exchange_rate_to_base") @db.Decimal(18, 8)
  externalReference String?   @map("external_reference") @db.VarChar(120)
  idempotencyKey String?      @unique @map("idempotency_key") @db.VarChar(120)
  reconciliationStatus String @default("unreconciled") @map("reconciliation_status") @db.VarChar(20)
  postingStatus String        @default("unposted") @map("posting_status") @db.VarChar(20)
  paymentMethod PaymentMethod @map("payment_method")
  reference     String?       @db.VarChar(80)
  paidAt        DateTime      @default(now()) @map("paid_at")
  notes         String?
  createdById   String        @map("created_by") @db.Uuid

  po        PurchaseOrder @relation(fields: [poId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])

  @@map("supplier_payments")
}

// ── Sales ──────────────────────────────────────────────────────────────────────

model Opportunity {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  name          String    @db.VarChar(200)
