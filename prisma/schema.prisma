// Deed ERP — Full Prisma Schema (PostgreSQL)
// npx prisma generate | npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  finance
  inventory
  kilimall
  technician
  sales
  director
  admin_officer
  finance_officer
  inventory_officer
  kilimall_officer
  sales_rep
  technical_lead
  super_admin
  lead_tech
  repair_tech
  release_authoriser

  @@map("user_role")
}

enum ProductType {
  new
  refurbished

  @@map("product_type")
}

enum TrackingMethod {
  NONE
  QUANTITY
  BATCH
  SERIAL

  @@map("tracking_method")
}

enum ConditionGrade {
  A
  B
  C
  parts_only

  @@map("condition_grade")
}

enum StockMovementType {
  purchase_receive
  sale
  repair_use
  adjustment_in
  adjustment_out
  return_from_client
  return_to_supplier
  transfer
  write_off
  opening_stock

  @@map("stock_movement_type")
}

enum DocumentStatus {
  draft
  pending_approval
  approved
  rejected
  invoiced
  dispatched
  delivered
  paid
  partially_paid
  cancelled
  voided @map("void")

  @@map("document_status")
}

enum PaymentMethod {
  cash
  mpesa
  bank_transfer
  card
  credit
  cheque

  @@map("payment_method")
}

enum RepairStatus {
  intake
  diagnosis
  awaiting_parts
  in_repair
  qc
  ready
  verified_released
  collected
  cancelled
  unrepairable

  @@map("repair_status")
}

enum DeliveryMethod {
  pickup
  courier
  own_delivery

  @@map("delivery_method")
}

enum LeaveType {
  annual
  sick
  maternity
  paternity
  compassionate
  unpaid
  study
  december_closure

  @@map("leave_type")
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
  pending_hr

  @@map("leave_status")
}

model LeavePolicy {
  id                  String   @id @default(uuid()) @db.Uuid
  effectiveYear       Int      @unique @map("effective_year")
  annualEntitlement   Int      @default(21) @map("annual_entitlement")
  discretionaryDays   Int      @default(13) @map("discretionary_days")
  closureDays         Int      @default(8)  @map("closure_days")
  closureStartMmDd    String   @default("12-23") @map("closure_start_mm_dd") @db.VarChar(5)
  closureEndMmDd      String   @default("01-02") @map("closure_end_mm_dd")   @db.VarChar(5)
  sickFullPayDays     Int      @default(7)  @map("sick_full_pay_days")
  sickHalfPayDays     Int      @default(7)  @map("sick_half_pay_days")
  maternityDays       Int      @default(90) @map("maternity_days")
  paternityDays       Int      @default(14) @map("paternity_days")
  compassionateDays   Int      @default(5)  @map("compassionate_days")
  studyDays           Int      @default(5)  @map("study_days")
  noticeShortDays     Int      @default(5)  @map("notice_short_days")
  noticeLongDays      Int      @default(14) @map("notice_long_days")
  noticeThreshold     Int      @default(3)  @map("notice_threshold")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("leave_policies")
}

enum KilimallOrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
  refunded

  @@map("kilimall_order_status")
}

enum TaxType {
  vat
  exempt
  zero_rated

  @@map("tax_type")
}

enum PurchaseOrderStatus {
  draft
  pending_approval
  approved
  partially_received
  received
  cancelled

  @@map("purchase_order_status")
}

// ── System / Auth ──────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String?   @unique @map("employee_id") @db.Uuid
  username     String    @unique @db.VarChar(60)
  email        String    @unique @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  passwordHash String    @map("password_hash")
  role         UserRole  @default(sales)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  mustResetPw  Boolean   @default(false) @map("must_reset_pw")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdById  String?   @map("created_by") @db.Uuid

  employee     Employee? @relation("UserEmployee", fields: [employeeId], references: [id])
  createdBy    User?     @relation("UserSelf", fields: [createdById], references: [id])
  createdUsers User[]    @relation("UserSelf")
  opportunitiesCreated Opportunity[] @relation("OpportunityOwner")
  opportunityAssignments Opportunity[] @relation("OpportunityAssignee")
  opportunityActivitiesCreated OpportunityActivity[] @relation("OpportunityActivityCreator")
  saleOrders           SaleOrder[] @relation("SaleOrderCreator")

  sessions             UserSession[]
  auditLogs            AuditLog[]
  settingUpdates       CompanySetting[]
  integrationUpdates   Integration[]
  employeeCreations    Employee[]                  @relation("EmployeeCreator")
  leaveReviews         LeaveRequest[]              @relation("LeaveReviewer")
  attendanceRecorded   AttendanceRecord[]          @relation("AttendanceRecorder")
  payrollApprovals     PayrollRun[]                @relation("PayrollApprover")
  payrollCreations     PayrollRun[]                @relation("PayrollCreator")
  loanCreations        EmployeeLoan[]
  clientCreations      Client[]
  supplierCreations    Supplier[]
  productValidations   Product[]                   @relation("ProductValidator")
  productCreations     Product[]                   @relation("ProductCreator")
  stockMovements       StockMovement[]
  adjApprovals         StockAdjustment[]           @relation("AdjApprover")
  adjCreations         StockAdjustment[]           @relation("AdjCreator")
  poApprovals          PurchaseOrder[]             @relation("POApprover")
  poCreations          PurchaseOrder[]             @relation("POCreator")
  grnCreations         GoodsReceivedNote[]
  supplierPayments     SupplierPayment[]
  quoteAssignments     Quote[]                     @relation("QuoteAssignee")
  quoteApprovals       Quote[]                     @relation("QuoteApprover")
  quoteCreations       Quote[]                     @relation("QuoteCreator")
  invoiceAssignments   Invoice[]                   @relation("InvoiceAssignee")
  invoiceApprovals     Invoice[]                   @relation("InvoiceApprover")
  invoiceCreations     Invoice[]                   @relation("InvoiceCreator")
  paymentCreations     Payment[]                   @relation("PaymentCreator")
  paymentVoids         Payment[]                   @relation("PaymentVoider")
  creditNoteCreations  CreditNote[]
  deliveryDispatches   DeliveryNote[]              @relation("DeliveryDispatcher")
  deliveryCreations    DeliveryNote[]              @relation("DeliveryCreator")
  repairAssignments    Repair[]                    @relation("RepairTech")
  repairCreations      Repair[]                    @relation("RepairCreator")
  repairStageChanges   RepairStage[]
  repairPartAdditions  RepairPart[]
  repairDiagnostics    RepairDiagnostic[]
  repairComms          RepairClientCommunication[]
  posSessions          PosSession[]
  posTransactions      PosTransaction[]
  kilimallListings     KilimallListing[]
  orcInitiations       OutboundRelease[]           @relation("OrcInitiator")
  orcVerifications     OutboundRelease[]           @relation("OrcVerifier")
  orcVoids             OutboundRelease[]           @relation("OrcVoider")
  orcItemVerifications OutboundReleaseItem[]       @relation("OrcItemVerifier")
  orcLogActions        OutboundReleaseLog[]        @relation("OrcLogActor")
  kilimallOrderProcs   KilimallOrder[]
  kilimallSyncLogs     KilimallSyncLog[]
  labelPrintJobs       LabelPrintJob[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_audit_user")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_date")
  @@map("audit_logs")
}

// ── Settings ───────────────────────────────────────────────────────────────────

model CompanySetting {
  id                String   @id @default(uuid()) @db.Uuid
  companyName       String   @default("Deed Technologies") @map("company_name") @db.VarChar(200)
  tradeName         String?  @map("trade_name") @db.VarChar(200)
  kraPin            String?  @map("kra_pin") @db.VarChar(20)
  vatNumber         String?  @map("vat_number") @db.VarChar(30)
  addressLine1      String?  @map("address_line1")
  addressLine2      String?  @map("address_line2")
  city              String?  @default("Nairobi") @db.VarChar(100)
  country           String?  @default("Kenya") @db.VarChar(100)
  phone             String?  @db.VarChar(20)
  email             String?  @db.VarChar(150)
  website           String?  @db.VarChar(200)
  logoUrl           String?  @map("logo_url")
  defaultCurrency   String   @default("KES") @map("default_currency") @db.VarChar(10)
  defaultVatRate    Decimal  @default(16.00) @map("default_vat_rate") @db.Decimal(5, 2)
  invoicePrefix     String   @default("INV") @map("invoice_prefix") @db.VarChar(10)
  quotePrefix       String   @default("QT") @map("quote_prefix") @db.VarChar(10)
  purchasePrefix    String   @default("PO") @map("purchase_prefix") @db.VarChar(10)
  repairPrefix      String   @default("RPR") @map("repair_prefix") @db.VarChar(10)
  invoiceSeq        Int      @default(1) @map("invoice_seq")
  quoteSeq          Int      @default(1) @map("quote_seq")
  purchaseSeq       Int      @default(1) @map("purchase_seq")
  repairSeq         Int      @default(1) @map("repair_seq")
  invoiceFooterNote String?  @map("invoice_footer_note")
  quoteValidityDays Int?     @default(7) @map("quote_validity_days")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedById       String?  @map("updated_by") @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("company_settings")
}

model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(60)
  rate      Decimal  @db.Decimal(5, 2)
  taxType   TaxType  @default(vat) @map("tax_type")
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("tax_rates")
}

model DocumentTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  type      String   @db.VarChar(40)
  bodyHtml  String?  @map("body_html")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("document_templates")
}

model NotificationTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  triggerEvent String   @map("trigger_event") @db.VarChar(80)
  channel      String   @db.VarChar(20)
  subject      String?  @db.VarChar(200)
  body         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("notification_templates")
}

model Integration {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(60)
  config       Json      @default("{}")
  isActive     Boolean   @default(false) @map("is_active")
  lastTestedAt DateTime? @map("last_tested_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedById  String?   @map("updated_by") @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("integrations")
}

// ── HR ─────────────────────────────────────────────────────────────────────────

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(100)
  description String?
  isActive    Boolean    @default(true) @map("is_active")

  employees Employee[]

  @@map("departments")
}

model Employee {
  id               String    @id @default(uuid()) @db.Uuid
  employeeNumber   String    @unique @map("employee_number") @db.VarChar(20)
  firstName        String    @map("first_name") @db.VarChar(80)
  lastName         String    @map("last_name") @db.VarChar(80)
  idNumber         String?   @unique @map("id_number") @db.VarChar(20)
  kraPin           String?   @map("kra_pin") @db.VarChar(20)
  nhifNumber       String?   @map("nhif_number") @db.VarChar(20)
  nssfNumber       String?   @map("nssf_number") @db.VarChar(20)
  shift            String?   @db.VarChar(50)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String?   @db.VarChar(10)
  phone            String?   @db.VarChar(20)
  email            String?   @db.VarChar(150)
  address          String?
  departmentId     String?   @map("department_id") @db.Uuid
  jobTitle         String?   @map("job_title") @db.VarChar(100)
  employmentType   String    @default("full_time") @map("employment_type") @db.VarChar(30)
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  basicSalary      Decimal   @default(0) @map("basic_salary") @db.Decimal(12, 2)
  paymentMode      String    @default("mpesa") @map("payment_mode") @db.VarChar(20)
  bankName         String?   @map("bank_name") @db.VarChar(100)
  bankAccount      String?   @map("bank_account") @db.VarChar(50)
  mpesaNumber      String?   @map("mpesa_number") @db.VarChar(20)
  annualLeaveDays  Int       @default(21) @map("annual_leave_days")
  sickLeaveDays    Int       @default(10) @map("sick_leave_days")
  emergencyContact Json?     @map("emergency_contact")
  isActive         Boolean   @default(true) @map("is_active")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdById      String?   @map("created_by") @db.Uuid

  department    Department?        @relation(fields: [departmentId], references: [id])
  createdBy     User?              @relation("EmployeeCreator", fields: [createdById], references: [id])
  user          User?              @relation("UserEmployee")
  leaveRequests LeaveRequest[]
  attendance    AttendanceRecord[]
  payslips      Payslip[]
  loans         EmployeeLoan[]
  commissions   SalesCommission[]

  @@index([departmentId], map: "idx_employees_department")
  @@map("employees")
}

model LeaveRequest {
  id            String      @id @default(uuid()) @db.Uuid
  employeeId    String      @map("employee_id") @db.Uuid
  leaveType     LeaveType   @map("leave_type")
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  daysRequested Decimal     @map("days_requested") @db.Decimal(4, 1)
  reason        String?
  status        LeaveStatus @default(pending)
  reviewedById  String?     @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?   @map("reviewed_at")
  reviewNotes   String?     @map("review_notes")
  createdAt     DateTime    @default(now()) @map("created_at")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@map("leave_requests")
}

model AttendanceRecord {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  workDate      DateTime  @map("work_date") @db.Date
  clockIn       DateTime? @map("clock_in")
  clockOut      DateTime? @map("clock_out")
  hoursWorked   Decimal?  @map("hours_worked") @db.Decimal(4, 2)
  isOvertime    Boolean   @default(false) @map("is_overtime")
  overtimeHours Decimal   @default(0) @map("overtime_hours") @db.Decimal(4, 2)
  notes         String?
  recordedById  String?   @map("recorded_by") @db.Uuid

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([employeeId, workDate])
  @@index([employeeId, workDate], map: "idx_attendance_employee_date")
  @@map("attendance_records")
}

model PayrollRun {
  id           String    @id @default(uuid()) @db.Uuid
  runReference String    @unique @map("run_reference") @db.VarChar(30)
  periodStart  DateTime  @map("period_start") @db.Date
  periodEnd    DateTime  @map("period_end") @db.Date
  runDate      DateTime  @map("run_date") @db.Date
  status       String    @default("draft") @db.VarChar(20)
  totalGross   Decimal   @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalPaye    Decimal   @default(0) @map("total_paye") @db.Decimal(14, 2)
  totalNhif    Decimal   @default(0) @map("total_nhif") @db.Decimal(14, 2)
  totalNssf    Decimal   @default(0) @map("total_nssf") @db.Decimal(14, 2)
  totalNet     Decimal   @default(0) @map("total_net") @db.Decimal(14, 2)
  notes        String?
  approvedById String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  approvedBy       User?             @relation("PayrollApprover", fields: [approvedById], references: [id])
  createdBy        User?             @relation("PayrollCreator", fields: [createdById], references: [id])
  payslips         Payslip[]
  salesCommissions SalesCommission[]

  @@map("payroll_runs")
}

model Payslip {
  id                 String    @id @default(uuid()) @db.Uuid
  payrollRunId       String    @map("payroll_run_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  basicSalary        Decimal   @map("basic_salary") @db.Decimal(12, 2)
  houseAllowance     Decimal   @default(0) @map("house_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal   @default(0) @map("transport_allowance") @db.Decimal(12, 2)
  commission         Decimal   @default(0) @db.Decimal(12, 2)
  overtimePay        Decimal   @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  otherAdditions     Decimal   @default(0) @map("other_additions") @db.Decimal(12, 2)
  grossPay           Decimal   @map("gross_pay") @db.Decimal(12, 2)
  paye               Decimal   @default(0) @db.Decimal(12, 2)
  nhif               Decimal   @default(0) @db.Decimal(12, 2)
  nssf               Decimal   @default(0) @db.Decimal(12, 2)
  otherDeductions    Decimal   @default(0) @map("other_deductions") @db.Decimal(12, 2)
  loanDeductions     Decimal   @default(0) @map("loan_deductions") @db.Decimal(12, 2)
  totalDeductions    Decimal   @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netPay             Decimal   @map("net_pay") @db.Decimal(12, 2)
  paymentStatus      String    @default("pending") @map("payment_status") @db.VarChar(20)
  paidAt             DateTime? @map("paid_at")
  paymentReference   String?   @map("payment_reference") @db.VarChar(60)
  createdAt          DateTime  @default(now()) @map("created_at")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@map("payslips")
}

model EmployeeLoan {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  monthlyDeduction Decimal  @map("monthly_deduction") @db.Decimal(12, 2)
  outstanding      Decimal  @db.Decimal(12, 2)
  issueDate        DateTime @map("issue_date") @db.Date
  reason           String?
  isCleared        Boolean  @default(false) @map("is_cleared")
  createdById      String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@map("employee_loans")
}

model SalesCommission {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  invoiceId        String?  @map("invoice_id") @db.Uuid
  periodMonth      Int      @map("period_month")
  periodYear       Int      @map("period_year")
  saleAmount       Decimal  @map("sale_amount") @db.Decimal(14, 2)
  commissionRate   Decimal  @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(12, 2)
  isPaid           Boolean  @default(false) @map("is_paid")
  paidViaPayrollId String?  @map("paid_via_payroll") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  employee       Employee    @relation(fields: [employeeId], references: [id])
  invoice        Invoice?    @relation("CommissionInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  paidViaPayroll PayrollRun? @relation(fields: [paidViaPayrollId], references: [id])

  @@map("sales_commissions")
}

// ── Clients / Suppliers ────────────────────────────────────────────────────────

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  clientNumber  String   @unique @map("client_number") @db.VarChar(20)
  name          String   @db.VarChar(200)
  industry      String?  @map("industry") @db.VarChar(100)
  segment       String?  @map("segment") @db.VarChar(100)
  tags          Json?    @default("[]")
  employees     Int?     @map("employees")
  companyName   String?  @map("company_name") @db.VarChar(200)
  clientType    String   @default("individual") @map("client_type") @db.VarChar(20)
  registrationNumber String? @map("registration_number") @db.VarChar(60)
  email         String?  @db.VarChar(150)
  phone         String?  @db.VarChar(20)
  phoneAlt      String?  @map("phone_alt") @db.VarChar(20)
  website       String?  @db.VarChar(200)
  idNumber      String?  @map("id_number") @db.VarChar(20)
  kraPin        String?  @map("kra_pin") @db.VarChar(20)
  addressLine1  String?  @map("address_line1")
  addressLine2  String?  @map("address_line2")
  city          String?  @db.VarChar(100)
  country       String?  @default("Kenya") @db.VarChar(100)
  creditLimit   Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditBalance Decimal  @default(0) @map("credit_balance") @db.Decimal(14, 2)
  isCustomer    Boolean  @default(true) @map("is_customer")
  isVendor      Boolean  @default(false) @map("is_vendor")
  paymentTermsDays Int?  @default(30) @map("payment_terms_days")
  bankName      String?  @map("bank_name") @db.VarChar(100)
  bankAccount   String?  @map("bank_account") @db.VarChar(80)
  bankBranch    String?  @map("bank_branch") @db.VarChar(100)
  vendorRating  Decimal? @map("vendor_rating") @db.Decimal(4, 2)
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdBy      User?            @relation(fields: [createdById], references: [id])
  quotes         Quote[]
  invoices       Invoice[]
  repairs        Repair[]         @relation("RepairClient")
  referrals      Repair[]         @relation("RepairReferrer")
  deliveries     DeliveryNote[]
  posTransactions PosTransaction[]
  kilimallOrders KilimallOrder[]
  creditNotes    CreditNote[]
  opportunities    Opportunity[]
  contactPersons   ContactPerson[]
  saleOrders       SaleOrder[]
  outboundReleases OutboundRelease[] @relation("OrcClient")
  customerAssets   CustomerAsset[]

  @@index([phone], map: "idx_clients_phone")
  @@index([email], map: "idx_clients_email")
  @@map("clients")
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  supplierNumber String   @unique @map("supplier_number") @db.VarChar(20)
  name           String   @db.VarChar(200)
  contactPerson  String?  @map("contact_person") @db.VarChar(150)
  email          String?  @db.VarChar(150)
  phone          String?  @db.VarChar(20)
  phoneAlt       String?  @map("phone_alt") @db.VarChar(20)
  kraPin         String?  @map("kra_pin") @db.VarChar(20)
  addressLine1   String?  @map("address_line1")
  city           String?  @db.VarChar(100)
  country        String?  @default("Kenya") @db.VarChar(100)
  paymentTerms   Int?     @default(30) @map("payment_terms")
  bankName       String?  @map("bank_name") @db.VarChar(100)
  bankAccount    String?  @map("bank_account") @db.VarChar(50)
  mpesaNumber    String?  @map("mpesa_number") @db.VarChar(20)
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  createdBy      User?           @relation(fields: [createdById], references: [id])
  purchaseOrders PurchaseOrder[]
  inventoryBatches InventoryBatch[]

  @@map("suppliers")
}

// ── Product Catalog ────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(100)
  parentId    String?    @map("parent_id") @db.Uuid
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(100)
  logoUrl  String?   @map("logo_url")
  isActive Boolean   @default(true) @map("is_active")

  products Product[]

  @@map("brands")
}

model Product {
  id               String      @id @default(uuid()) @db.Uuid
  sku              String      @unique @db.VarChar(60)
  barcode          String?     @unique @db.VarChar(60)
  name             String      @db.VarChar(200)
  shortDescription String?     @map("short_description")
  description      String?
  productType      ProductType @default(new) @map("product_type")
  categoryId       String?     @map("category_id") @db.Uuid
  brandId          String?     @map("brand_id") @db.Uuid
  modelNumber      String?     @map("model_number") @db.VarChar(100)
  specs            Json        @default("{}")
  costPrice        Decimal     @default(0) @map("cost_price") @db.Decimal(14, 2)
  sellingPrice     Decimal     @default(0) @map("selling_price") @db.Decimal(14, 2)
  wholesalePrice   Decimal?    @map("wholesale_price") @db.Decimal(14, 2)
  kilimallPrice    Decimal?    @map("kilimall_price") @db.Decimal(14, 2)
  taxRateId        String?     @map("tax_rate_id") @db.Uuid
  isTaxInclusive   Boolean     @default(false) @map("is_tax_inclusive")
  trackStock       Boolean     @default(true) @map("track_stock")
  trackingMethod   TrackingMethod @default(QUANTITY) @map("tracking_method")
  reorderLevel     Int?        @default(2) @map("reorder_level")
  reorderQty       Int?        @default(5) @map("reorder_qty")
  isActive         Boolean     @default(true) @map("is_active")
  isValidated      Boolean     @default(false) @map("is_validated")
  validatedById    String?     @map("validated_by") @db.Uuid
  validatedAt      DateTime?   @map("validated_at")
  isListedKilimall Boolean     @default(false) @map("is_listed_kilimall")
  primaryImageUrl  String?     @map("primary_image_url")
  createdById      String?     @map("created_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  category           Category?           @relation(fields: [categoryId], references: [id])
  brand              Brand?              @relation(fields: [brandId], references: [id])
  taxRate            TaxRate?            @relation(fields: [taxRateId], references: [id])
  validatedBy        User?               @relation("ProductValidator", fields: [validatedById], references: [id])
  createdBy          User?               @relation("ProductCreator", fields: [createdById], references: [id])
  images             ProductImage[]
  serials            SerialNumber[]
  stockLevel         StockLevel?
  stockMovements     StockMovement[]
  inventoryBatches   InventoryBatch[]
  customerAssets     CustomerAsset[]
  adjItems           StockAdjustmentItem[]
  poItems            PurchaseOrderItem[]
  grnItems           GrnItem[]
  quoteItems         QuoteItem[]
  invoiceItems       InvoiceItem[]
  deliveryItems      DeliveryNoteItem[]
  repairParts        RepairPart[]
  posItems           PosTransactionItem[]
  kilimallListing    KilimallListing?
  kilimallOrderItems KilimallOrderItem[]
  saleOrderItems     SaleOrderItem[]


  @@index([sku], map: "idx_products_sku")
  @@index([barcode], map: "idx_products_barcode")
  @@index([categoryId], map: "idx_products_category")
  @@index([brandId], map: "idx_products_brand")
  @@index([productType], map: "idx_products_type")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model SerialNumber {
  id               String         @id @default(uuid()) @db.Uuid
  productId        String         @map("product_id") @db.Uuid
  serialNumber     String         @unique @map("serial_number") @db.VarChar(100)
  inventoryBarcode String?        @unique @map("inventory_barcode") @db.VarChar(120)
  conditionGrade   ConditionGrade? @map("condition_grade")
  status           String         @default("in_stock") @db.VarChar(30)
  purchaseItemId   String?        @map("purchase_item_id") @db.Uuid
  soldViaInvoiceId String?        @map("sold_via_invoice_id") @db.Uuid
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItem   GrnItem?       @relation("SerialGrnItem", fields: [purchaseItemId], references: [id])
  soldViaInvoice Invoice?       @relation("SerialSoldInvoice", fields: [soldViaInvoiceId], references: [id])
  stockMovements StockMovement[]

  invoiceItems   InvoiceItem[]
  saleOrderItems SaleOrderItem[]
  deliveryNoteItems DeliveryNoteItem[]

  repairParts    RepairPart[]
  posItems       PosTransactionItem[]
  orcItems       OutboundReleaseItem[] @relation("SerialOrcItems")
  customerAssets CustomerAsset[]

  @@index([productId], map: "idx_serials_product")
  @@index([status], map: "idx_serials_status")
  @@map("serial_numbers")
}

model StockLevel {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @unique @map("product_id") @db.Uuid
  qtyOnHand     Int       @default(0) @map("qty_on_hand")
  qtyReserved   Int       @default(0) @map("qty_reserved")
  qtyOnOrder    Int       @default(0) @map("qty_on_order")
  lastCountedAt DateTime? @map("last_counted_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_levels")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  serialNumberId String?           @map("serial_number_id") @db.Uuid
  batchId        String?           @map("batch_id") @db.Uuid
  movementType   StockMovementType @map("movement_type")
  qty            Int
  qtyBefore      Int               @map("qty_before")
  qtyAfter       Int               @map("qty_after")
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  referenceType  String?           @map("reference_type") @db.VarChar(40)
  referenceId    String?           @map("reference_id") @db.Uuid
  notes          String?
  createdById    String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  product      Product       @relation(fields: [productId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id])
  batch        InventoryBatch? @relation(fields: [batchId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([productId], map: "idx_stock_movements_product")
  @@index([referenceType, referenceId], map: "idx_stock_movements_ref")
  @@index([createdAt], map: "idx_stock_movements_date")
  @@map("stock_movements")
}

model InventoryBatch {
  id                String    @id @default(uuid()) @db.Uuid
  batchNumber       String    @map("batch_number") @db.VarChar(100)
  productId         String    @map("product_id") @db.Uuid
  warehouseId       String    @map("warehouse_id") @db.VarChar(80)
  locationId        String?   @map("location_id") @db.VarChar(80)
  quantityReceived  Int       @default(0) @map("quantity_received")
  quantityAvailable Int       @default(0) @map("quantity_available")
  unitCost          Decimal?  @map("unit_cost") @db.Decimal(14, 2)
  expiryDate        DateTime? @map("expiry_date") @db.Date
  supplierId        String?   @map("supplier_id") @db.Uuid
  purchaseOrderId   String?   @map("purchase_order_id") @db.Uuid
  receivedLineId    String?   @map("received_line_id") @db.Uuid
  receivedAt        DateTime  @default(now()) @map("received_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  receivedLine  GrnItem?       @relation(fields: [receivedLineId], references: [id])
  stockMovements StockMovement[]

  @@unique([productId, batchNumber], map: "idx_inventory_batches_product_batch")
  @@index([warehouseId], map: "idx_inventory_batches_warehouse")
  @@index([quantityAvailable], map: "idx_inventory_batches_qty_available")
  @@map("inventory_batches")
}

model LabelPrintJob {
  id         String   @id @default(uuid()) @db.Uuid
  sourceType String   @map("source_type") @db.VarChar(50)
  sourceId   String   @map("source_id") @db.Uuid
  labelType  String   @map("label_type") @db.VarChar(40)
  status     String   @default("queued") @db.VarChar(20)
  payload    Json     @default("{}")
  createdById String? @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  printedAt  DateTime? @map("printed_at")

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([sourceType, sourceId], map: "idx_label_print_jobs_source")
  @@index([status], map: "idx_label_print_jobs_status")
  @@map("label_print_jobs")
}

model CustomerAsset {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  serialNumber    String?  @map("serial_number") @db.VarChar(100)
  saleId          String?  @map("sale_id") @db.Uuid
  warrantyStart   DateTime? @map("warranty_start") @db.Date
  warrantyEnd     DateTime? @map("warranty_end") @db.Date
  status          String   @default("active") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer      Client       @relation(fields: [customerId], references: [id])
  product       Product      @relation(fields: [productId], references: [id])
  inventoryItem SerialNumber @relation(fields: [inventoryItemId], references: [id])
  saleOrder     SaleOrder?   @relation(fields: [saleId], references: [id])

  @@index([customerId], map: "idx_customer_assets_customer")
  @@index([inventoryItemId], map: "idx_customer_assets_inventory_item")
  @@index([saleId], map: "idx_customer_assets_sale")
  @@map("customer_assets")
}

model StockAdjustment {
  id           String    @id @default(uuid()) @db.Uuid
  reference    String    @unique @db.VarChar(30)
  reason       String    @db.VarChar(200)
  notes        String?
  status       String    @default("draft") @db.VarChar(20)
  approvedById String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  createdById  String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  approvedBy User?                 @relation("AdjApprover", fields: [approvedById], references: [id])
  createdBy  User                  @relation("AdjCreator", fields: [createdById], references: [id])
  items      StockAdjustmentItem[]

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String   @id @default(uuid()) @db.Uuid
  adjustmentId String   @map("adjustment_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  qtySystem    Int      @map("qty_system")
  qtyCounted   Int      @map("qty_counted")
  // variance = qtyCounted - qtySystem — compute in application
  unitCost     Decimal? @map("unit_cost") @db.Decimal(14, 2)
  notes        String?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@map("stock_adjustment_items")
}

// ── Purchases ──────────────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  poNumber        String              @unique @map("po_number") @db.VarChar(30)
  supplierId      String              @map("supplier_id") @db.Uuid
  status          PurchaseOrderStatus @default(draft)
  orderDate       DateTime            @default(now()) @map("order_date") @db.Date
  expectedDate    DateTime?           @map("expected_date") @db.Date
  deliveryAddress String?             @map("delivery_address")
  subtotal        Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 2)
  discountAmount  Decimal             @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount     Decimal             @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid      Decimal             @default(0) @map("amount_paid") @db.Decimal(14, 2)
  notes           String?
  internalNotes   String?             @map("internal_notes")
  approvedById    String?             @map("approved_by") @db.Uuid
  approvedAt      DateTime?           @map("approved_at")
  createdById     String              @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  approvedBy       User?               @relation("POApprover", fields: [approvedById], references: [id])
  createdBy        User                @relation("POCreator", fields: [createdById], references: [id])
  items            PurchaseOrderItem[]
  grns             GoodsReceivedNote[]
  supplierPayments SupplierPayment[]
  inventoryBatches InventoryBatch[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  poId        String   @map("po_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  description String?
  qtyOrdered  Int      @map("qty_ordered")
  qtyReceived Int      @default(0) @map("qty_received")
  unitCost    Decimal  @map("unit_cost") @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(14, 2)
  notes       String?

  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
  grnItems GrnItem[]

  @@map("purchase_order_items")
}

model GoodsReceivedNote {
  id                String   @id @default(uuid()) @db.Uuid
  grnNumber         String   @unique @map("grn_number") @db.VarChar(30)
  poId              String   @map("po_id") @db.Uuid
  receivedDate      DateTime @default(now()) @map("received_date") @db.Date
  supplierInvoiceNo String?  @map("supplier_invoice_no") @db.VarChar(60)
  notes             String?
  createdById       String   @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  po        PurchaseOrder @relation(fields: [poId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     GrnItem[]

  @@map("goods_received_notes")
}

model GrnItem {
  id            String   @id @default(uuid()) @db.Uuid
  grnId         String   @map("grn_id") @db.Uuid
  poItemId      String   @map("po_item_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  qtyReceived   Int      @map("qty_received")
  unitCost      Decimal  @map("unit_cost") @db.Decimal(14, 2)
  conditionNote String?  @map("condition_note")
  serialNumbers String[] @map("serial_numbers")

  grn     GoodsReceivedNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem  PurchaseOrderItem   @relation(fields: [poItemId], references: [id])
  product Product             @relation(fields: [productId], references: [id])
  serials SerialNumber[]      @relation("SerialGrnItem")
  inventoryBatches InventoryBatch[]

  @@map("grn_items")
}

model SupplierPayment {
  id            String        @id @default(uuid()) @db.Uuid
  poId          String        @map("po_id") @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod @map("payment_method")
  reference     String?       @db.VarChar(80)
  paidAt        DateTime      @default(now()) @map("paid_at")
  notes         String?
  createdById   String        @map("created_by") @db.Uuid

  po        PurchaseOrder @relation(fields: [poId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])

  @@map("supplier_payments")
}

// ── Sales ──────────────────────────────────────────────────────────────────────

model Opportunity {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  name          String    @db.VarChar(200)
  description   String?   @db.Text
  stage         String    @default("new") @db.VarChar(50)
  closeDate     DateTime? @map("close_date") @db.Date
  value         Decimal   @default(0) @db.Decimal(14, 2)
  probability   Int       @default(0)
  assignedToId  String?   @map("assigned_to") @db.Uuid
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  client              Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo          User?                 @relation("OpportunityAssignee", fields: [assignedToId], references: [id])
  createdBy           User                  @relation("OpportunityOwner", fields: [createdById], references: [id])
  activities          OpportunityActivity[]
  quotes              Quote[]               @relation("OpportunityQuotes")

  @@index([clientId], map: "idx_opportunities_client")
  @@index([assignedToId], map: "idx_opportunities_assigned_to")
  @@map("opportunities")
}

model OpportunityActivity {
  id            String    @id @default(uuid()) @db.Uuid
  opportunityId String    @map("opportunity_id") @db.Uuid
  type          String    @db.VarChar(50)
  description   String?   @db.Text
  scheduledAt   DateTime? @map("scheduled_at")
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("OpportunityActivityCreator", fields: [createdById], references: [id])

  @@index([opportunityId], map: "idx_opportunity_activities_opportunity")
  @@map("opportunity_activities")
}

model ContactPerson {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  firstName String    @map("first_name") @db.VarChar(80)
  lastName  String    @map("last_name") @db.VarChar(80)
  email     String?   @db.VarChar(150)
  phone     String?   @db.VarChar(20)
  position  String?   @db.VarChar(100)
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId], map: "idx_contact_persons_client")
  @@map("contact_persons")
}

model SaleOrder {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number") @db.VarChar(30)
  clientId        String        @map("client_id") @db.Uuid
  quoteId         String?       @unique @map("quote_id") @db.Uuid
  status          String        @default("pending") @db.VarChar(50)
  orderDate       DateTime      @default(now()) @map("order_date") @db.Date
  deliveryDate    DateTime?     @map("delivery_date") @db.Date
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount     Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  notes           String?       @db.Text
  createdById     String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote     Quote?          @relation("QuoteToSaleOrder", fields: [quoteId], references: [id])
  createdBy User            @relation("SaleOrderCreator", fields: [createdById], references: [id])
  items     SaleOrderItem[]
  invoices  Invoice[]       @relation("InvoiceSourceSaleOrder")
  deliveries DeliveryNote[] @relation("DeliveryNoteSaleOrders")
  customerAssets CustomerAsset[]

  @@index([clientId], map: "idx_sale_orders_client")
  @@index([createdById], map: "idx_sale_orders_created_by")
  @@map("sale_orders")
}

model SaleOrderItem {
  id            String    @id @default(uuid()) @db.Uuid
  saleOrderId   String    @map("sale_order_id") @db.Uuid
  productId     String?   @map("product_id") @db.Uuid
  description   String?   @db.Text
  qty           Int
  qtyDelivered  Int       @default(0) @map("qty_delivered")
  unitPrice     Decimal   @db.Decimal(14, 2)
