  @@map("stock_levels")
}

/**
 * Location/bin-level bulk stock (e.g. warehouse, shop, pending_testing,
 * quarantine) — the relational counterpart of the legacy deed_bulkStock
 * blob array ({productId, location, qty}). StockLevel above tracks only an
 * aggregate qtyOnHand with no location dimension; this table is the
 * durable, queryable source for "how much of this product is sitting in
 * THIS specific bin right now" (used first by device reconfiguration's
 * component remove/install stock moves).
 */
model BulkStockLevel {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  location  String   @default("warehouse") @db.VarChar(30)
  qty       Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location], map: "uq_bulk_stock_product_location")
  @@index([location], map: "idx_bulk_stock_location")
  @@map("bulk_stock_levels")
}

