// ── POS ────────────────────────────────────────────────────────────────────────

model PosSession {
  id             String    @id @default(uuid()) @db.Uuid
  sessionNumber  String    @unique @map("session_number") @db.VarChar(30)
  cashierId      String    @map("cashier_id") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  openingFloat   Decimal   @default(0) @map("opening_float") @db.Decimal(14, 2)
  closingFloat   Decimal?  @map("closing_float") @db.Decimal(14, 2)
  expectedCash   Decimal?  @map("expected_cash") @db.Decimal(14, 2)
  cashDifference Decimal?  @map("cash_difference") @db.Decimal(14, 2)
  totalSales     Decimal   @default(0) @map("total_sales") @db.Decimal(14, 2)
  totalCash      Decimal   @default(0) @map("total_cash") @db.Decimal(14, 2)
  totalMpesa     Decimal   @default(0) @map("total_mpesa") @db.Decimal(14, 2)
  totalCard      Decimal   @default(0) @map("total_card") @db.Decimal(14, 2)
  notes          String?
