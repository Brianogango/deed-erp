  serialNumbers  String[]          @default([]) @map("serial_numbers")

  product      Product       @relation(fields: [productId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@unique([blobId], map: "uq_stock_movements_blob_id")
  @@index([productId], map: "idx_stock_movements_product")
  @@index([referenceType, referenceId], map: "idx_stock_movements_ref")
  @@index([createdAt], map: "idx_stock_movements_date")
  @@index([documentRef], map: "idx_stock_movements_document_ref")
  @@map("stock_movements")
}

model StockAdjustment {
  id           String    @id @default(uuid()) @db.Uuid
  reference    String    @unique @db.VarChar(30)
  reason       String    @db.VarChar(200)
  notes        String?
  status       String    @default("draft") @db.VarChar(20)
  approvedById String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  createdById  String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  approvedBy User?                 @relation("AdjApprover", fields: [approvedById], references: [id])
  createdBy  User                  @relation("AdjCreator", fields: [createdById], references: [id])
