model ContactPerson {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  firstName String    @map("first_name") @db.VarChar(80)
  lastName  String    @map("last_name") @db.VarChar(80)
  email     String?   @db.VarChar(150)
  phone     String?   @db.VarChar(20)
  position  String?   @db.VarChar(100)
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId], map: "idx_contact_persons_client")
  @@map("contact_persons")
}

model Lead {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(200)
  companyName   String?  @map("company_name") @db.VarChar(200)
  email         String?  @db.VarChar(150)
  phone         String?  @db.VarChar(20)
  source        String?  @db.VarChar(50)
  stage         String   @default("new") @db.VarChar(30)
  ownerId       String?  @map("owner_id") @db.Uuid
  opportunityId String?  @map("opportunity_id") @db.Uuid
  clientId      String?  @map("client_id") @db.Uuid
  notes         String?
  /** IMAP Message-ID (or synthetic key) for inbound sales-inbox dedupe. */
  inboundMessageId String? @unique @map("inbound_message_id") @db.VarChar(500)
  /** Provider thread id — one active lead per thread (Invariant 5). */
  inboundThreadId  String? @map("inbound_thread_id") @db.VarChar(500)
  /** Structured inbound email context (sales@ → CRM). */
  emailSubject       String?   @map("email_subject") @db.VarChar(500)
  emailSnippet       String?   @map("email_snippet") @db.VarChar(500)
  emailBody          String?   @map("email_body")
  emailReceivedAt    DateTime? @map("email_received_at")
  /** [{ id, name, size, contentType }] — files under .uploads/lead-attachments/<leadId>/ */
  emailAttachments   Json?     @map("email_attachments")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner       User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  inboundEmails SalesInboundEmail[]

  @@index([stage], map: "idx_leads_stage")
  @@index([ownerId], map: "idx_leads_owner")
  @@index([inboundThreadId], map: "idx_leads_inbound_thread_id")
  @@map("leads")
}

/** Idempotent record of every processed sales@ message (Invariant 6 + audit). */
model SalesInboundEmail {
  id                 String   @id @default(uuid()) @db.Uuid
  provider           String   @default("IMAP") @db.VarChar(20)
  mailbox            String   @db.VarChar(200)
  providerMessageId  String   @map("provider_message_id") @db.VarChar(500)
  providerThreadId   String?  @map("provider_thread_id") @db.VarChar(500)
  internetMessageId  String?  @map("internet_message_id") @db.VarChar(500)
  fromEmail          String?  @map("from_email") @db.VarChar(150)
  fromName           String?  @map("from_name") @db.VarChar(200)
  subject            String?  @db.VarChar(500)
  receivedAt         DateTime? @map("received_at")
  processingStatus   String   @default("RECEIVED") @map("processing_status") @db.VarChar(40)
  processingReason   String?  @map("processing_reason") @db.VarChar(200)
  classification     String?  @db.VarChar(60)
  confidence         Decimal? @db.Decimal(5, 4)
  classifierVersion  String?  @map("classifier_version") @db.VarChar(40)
  leadId             String?  @map("lead_id") @db.Uuid
  clientId           String?  @map("client_id") @db.Uuid
  decision           String?  @db.VarChar(40)
  rawMeta            Json?    @map("raw_meta")
  processedAt        DateTime? @map("processed_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([provider, mailbox, providerMessageId], map: "sales_inbound_emails_provider_msg_uniq")
  @@index([providerThreadId], map: "idx_sales_inbound_emails_thread")
  @@index([processingStatus], map: "idx_sales_inbound_emails_status")
  @@map("sales_inbound_emails")
}

model SaleOrder {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number") @db.VarChar(30)
  // Original quotation number (QUO/…), kept when confirmation assigns the SO number.
  quotationRef    String?       @map("quotation_ref") @db.VarChar(30)
  // Pro-forma invoice number (PI/…), assigned the first time a pro-forma is issued.
  proformaRef     String?       @map("proforma_ref") @db.VarChar(30)
  clientId        String        @map("client_id") @db.Uuid
  quoteId         String?       @unique @map("quote_id") @db.Uuid
  // Odoo-style states: quotation | quotation_sent | sale | cancelled.
  status          String        @default("quotation") @db.VarChar(50)
  orderDate       DateTime      @default(now()) @map("order_date") @db.Date
  deliveryDate    DateTime?     @map("delivery_date") @db.Date
  validUntil      DateTime?     @map("valid_until") @db.Date
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount     Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  notes           String?       @db.Text
  // Quotation Sent metadata (recorded when Send by Email succeeds).
  sentAt          DateTime?     @map("sent_at")
  sentById        String?       @map("sent_by") @db.Uuid
  sentTo          String?       @map("sent_to") @db.VarChar(255)
  sentMessage     String?       @map("sent_message") @db.Text
  // Customer acceptance (portal or staff). Distinct from Sent — freezes the
  // commercial snapshot until Reset to Draft / new version / Confirm.
  acceptedAt      DateTime?     @map("accepted_at")
  acceptedById    String?       @map("accepted_by") @db.Uuid
  // Odoo sale-order commercial fields.
  pricelist       String?       @db.VarChar(120)
  pricelistId     String?       @map("pricelist_id") @db.Uuid
  currencyCode        String   @default("KES") @map("currency_code") @db.VarChar(3)
  baseCurrencyCode    String   @default("KES") @map("base_currency_code") @db.VarChar(3)
  exchangeRateToBase  Decimal  @default(1) @map("exchange_rate_to_base") @db.Decimal(18, 8)
  salespersonId   String?       @map("salesperson_id") @db.Uuid
  salespersonName String?       @map("salesperson_name") @db.VarChar(120)
  salesTeam       String?       @map("sales_team") @db.VarChar(120)
  // Net payment terms in days (0 = due immediately). Previously only lived on
  // the client-store blob and was silently dropped on server sync.
  paymentTermsDays Int?         @map("payment_terms_days")
  // Sales Order confirmation metadata.
  confirmedAt     DateTime?     @map("confirmed_at")
  confirmedById   String?       @map("confirmed_by") @db.Uuid
  // Lock Confirmed Sales (optional setting): commercial fields frozen.
  locked          Boolean       @default(false)
  customerRef     String?       @map("customer_ref") @db.VarChar(120)
  invoiceAddress  String?       @map("invoice_address")
  deliveryAddress String?       @map("delivery_address")
  // Quotation versioning: versionNumber counts up within a lineage;
  // versionGroupId points at the v1 (root) row's own id for every row in the
  // lineage, including the root itself, once a second version is created.
  // Null versionGroupId (the common case) means this quote was never
  // versioned — it is implicitly its own v1.
  versionNumber   Int           @default(1) @map("version_number")
  versionGroupId  String?       @map("version_group_id") @db.Uuid
  lockVersion     Int           @default(0) @map("lock_version")
  createdById     String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote     Quote?          @relation("QuoteToSaleOrder", fields: [quoteId], references: [id])
  priceList PriceList?      @relation(fields: [pricelistId], references: [id], onDelete: SetNull)
  createdBy User            @relation("SaleOrderCreator", fields: [createdById], references: [id])
  items     SaleOrderItem[]
  invoices  Invoice[]       @relation("InvoiceSourceSaleOrder")
  deliveries DeliveryNote[] @relation("DeliveryNoteSaleOrders")
  deliveryNotesDirect DeliveryNote[] @relation("DeliveryNoteSaleOrder")
  customerAssets CustomerAsset[]
  reconfigurationWorkOrders ReconfigurationWorkOrder[]

  @@unique([versionGroupId, versionNumber], map: "ux_sale_orders_version")
  @@index([clientId], map: "idx_sale_orders_client")
  @@index([createdById], map: "idx_sale_orders_created_by")
  @@index([clientId, status], map: "idx_sale_orders_client_status")
  @@index([versionGroupId], map: "idx_sale_orders_version_group")
  @@index([status], map: "idx_sale_orders_status")
  @@index([salespersonId], map: "idx_sale_orders_salesperson")
  @@map("sale_orders")
}

model SaleOrderItem {
  id            String    @id @default(uuid()) @db.Uuid
  saleOrderId   String    @map("sale_order_id") @db.Uuid
  productId     String?   @map("product_id") @db.Uuid
  description   String?   @db.Text
  qty           Int
  qtyDelivered  Int       @default(0) @map("qty_delivered")
  qtyInvoiced   Int       @default(0) @map("qty_invoiced")
  unitPrice     Decimal   @db.Decimal(14, 2)
  taxRate       Decimal   @default(0) @db.Decimal(5, 2)
  // Per-line discount percent (0-100), already baked into lineTotal at write
  // time. Persisted explicitly (not just derived from lineTotal) so the UI
  // can show/re-edit the original discount after a reload, and so
  // create-invoice can prorate it correctly instead of re-pricing from a
  // bare unitPrice x qty that silently drops the discount.
  discountPct   Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2)
  lineTotal     Decimal   @db.Decimal(14, 2)
  notes         String?   @db.Text
  serialNumberId String?  @map("serial_number_id") @db.Uuid

  saleOrder   SaleOrder     @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id])



  @@index([saleOrderId], map: "idx_sale_order_items_sale_order")
  @@index([productId], map: "idx_sale_order_items_product")
  @@map("sale_order_items")
}

model Quote {
  id             String         @id @default(uuid()) @db.Uuid
  quoteNumber    String         @unique @map("quote_number") @db.VarChar(30)
  clientId       String         @map("client_id") @db.Uuid
  assignedToId   String?        @map("assigned_to") @db.Uuid
  status         DocumentStatus @default(draft)
  quoteDate      DateTime       @default(now()) @map("quote_date") @db.Date
  validUntil     DateTime?      @map("valid_until") @db.Date
  opportunityId  String?        @map("opportunity_id") @db.Uuid
  subject        String?        @db.VarChar(200)
  subtotal       Decimal        @default(0) @db.Decimal(14, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  discountPct    Decimal        @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  notes          String?
  internalNotes  String?        @map("internal_notes")
  terms          String?
  pricelist      String?        @db.VarChar(120)
  pricelistId    String?        @map("pricelist_id") @db.Uuid
  currencyCode       String  @default("KES") @map("currency_code") @db.VarChar(3)
  baseCurrencyCode   String  @default("KES") @map("base_currency_code") @db.VarChar(3)
  exchangeRateToBase Decimal @default(1) @map("exchange_rate_to_base") @db.Decimal(18, 8)
  approvedById   String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at")
  convertedToId  String?        @map("converted_to") @db.Uuid
  createdById    String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  client      Client      @relation(fields: [clientId], references: [id])
  assignedTo  User?       @relation("QuoteAssignee", fields: [assignedToId], references: [id])
  approvedBy  User?       @relation("QuoteApprover", fields: [approvedById], references: [id])
  convertedTo Invoice?    @relation("QuoteConvertedTo", fields: [convertedToId], references: [id], onDelete: SetNull)
  createdBy   User        @relation("QuoteCreator", fields: [createdById], references: [id])
  priceList   PriceList?  @relation(fields: [pricelistId], references: [id], onDelete: SetNull)
  items       QuoteItem[]
  invoices    Invoice[]   @relation("InvoiceSourceQuote")
  opportunity Opportunity?  @relation("OpportunityQuotes", fields: [opportunityId], references: [id])
  saleOrders  SaleOrder[]   @relation("QuoteToSaleOrder")

  @@index([clientId], map: "idx_quotes_client")
  @@index([status], map: "idx_quotes_status")
  @@map("quotes")
}

model QuoteItem {
  id           String   @id @default(uuid()) @db.Uuid
  quoteId      String   @map("quote_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  description  String
  qty          Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(14, 2)
  discountPct  Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal Decimal  @map("line_subtotal") @db.Decimal(14, 2)
  lineTax      Decimal  @default(0) @map("line_tax") @db.Decimal(14, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(14, 2)
  sortOrder    Int      @default(0) @map("sort_order")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

model Invoice {
  id             String         @id @default(uuid()) @db.Uuid
  invoiceNumber  String         @unique @map("invoice_number") @db.VarChar(30)
  clientId       String         @map("client_id") @db.Uuid
  quoteId        String?        @map("quote_id") @db.Uuid
  saleOrderId    String?        @map("sale_order_id") @db.Uuid
  // Vendor bills / vendor credit notes (client-vendor Invoice rows) against a
  // Purchase Order — needed for server-side 3-way-match enforcement.
  purchaseOrderId String?       @map("purchase_order_id") @db.Uuid
  repairId       String?        @map("repair_id") @db.Uuid
  assignedToId   String?        @map("assigned_to") @db.Uuid
  status         DocumentStatus @default(draft)
  invoiceDate    DateTime       @default(now()) @map("invoice_date") @db.Date
  dueDate        DateTime?      @map("due_date") @db.Date
  subject        String?        @db.VarChar(200)
  subtotal       Decimal        @default(0) @db.Decimal(14, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  discountPct    Decimal        @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid     Decimal        @default(0) @map("amount_paid") @db.Decimal(14, 2)
  // balanceDue = totalAmount - amountPaid — compute in application
  notes          String?
  internalNotes  String?        @map("internal_notes")
  terms          String?
  // Carried forward from the source sale order (Odoo invoice/delivery address).
  invoiceAddress  String?       @map("invoice_address")
  deliveryAddress String?       @map("delivery_address")
  // Finance dispute flag — Odoo's "Blocked" payment status is derived from it.
  paymentBlocked Boolean        @default(false) @map("payment_blocked")
  isPosInvoice   Boolean        @default(false) @map("is_pos_invoice")
  // Odoo-style down payment: deposit invoice against a Sale Order. Does not
  // bump product qtyInvoiced; final invoice deducts unapplied downs.
  isDownPayment          Boolean  @default(false) @map("is_down_payment")
  downPaymentPercent     Decimal? @map("down_payment_percent") @db.Decimal(5, 2)
  downPaymentAppliedToId String?  @map("down_payment_applied_to") @db.Uuid
  currencyCode       String  @default("KES") @map("currency_code") @db.VarChar(3)
  baseCurrencyCode   String  @default("KES") @map("base_currency_code") @db.VarChar(3)
  exchangeRateToBase Decimal @default(1) @map("exchange_rate_to_base") @db.Decimal(18, 8)
  approvedById   String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at")
  // Atomic claim for sales-commission calculation on posting — an
  // updateMany(where: { commissionComputedAt: null }) is the idempotency
  // lock, not a findFirst-then-create race. See lib/accounting/sales-commission.ts.
  commissionComputedAt DateTime? @map("commission_computed_at")
  lockVersion    Int            @default(0) @map("lock_version")
  documentType   String         @default("customer_invoice") @map("document_type") @db.VarChar(40)
  postingStatus  String         @default("unposted") @map("posting_status") @db.VarChar(20)
  postedJournalEntryId String?   @map("posted_journal_entry_id") @db.Uuid
  postedAt       DateTime?      @map("posted_at")
  postedById     String?        @map("posted_by_id") @db.Uuid
  sourceVersionHash String?     @map("source_version_hash") @db.VarChar(128)
  taxPoint       DateTime?      @map("tax_point") @db.Date
  etimsControlUnitNumber String? @map("etims_control_unit_number") @db.VarChar(100)
  etimsInvoiceNumber String?    @map("etims_invoice_number") @db.VarChar(100)
  etimsQrReference String?      @map("etims_qr_reference") @db.VarChar(255)
  etimsTransmissionStatus String @default("not_required") @map("etims_transmission_status") @db.VarChar(30)
  etimsTransmittedAt DateTime?  @map("etims_transmitted_at")
  createdById    String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  client          Client          @relation(fields: [clientId], references: [id])
  quote           Quote?          @relation("InvoiceSourceQuote", fields: [quoteId], references: [id])
  purchaseOrder   PurchaseOrder?  @relation("PurchaseOrderInvoices", fields: [purchaseOrderId], references: [id])
  repair          Repair?         @relation("InvoiceRepair", fields: [repairId], references: [id], onDelete: SetNull)
  assignedTo      User?           @relation("InvoiceAssignee", fields: [assignedToId], references: [id])
  approvedBy      User?           @relation("InvoiceApprover", fields: [approvedById], references: [id])
  createdBy       User            @relation("InvoiceCreator", fields: [createdById], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  paymentAllocations PaymentAllocation[]
  creditNotes     CreditNote[]    @relation("CreditNoteInvoice")
  creditApplied   CreditNote[]    @relation("CreditNoteApplied")
  deliveries      DeliveryNote[]
  posTransactions PosTransaction[]
  kilimallOrders  KilimallOrder[]
  quotesConverted Quote[]         @relation("QuoteConvertedTo")
  saleOrders      SaleOrder[]     @relation("InvoiceSourceSaleOrder")
  serialsSold     SerialNumber[]  @relation("SerialSoldInvoice")
  commissions     SalesCommission[] @relation("CommissionInvoice")
  repairs         Repair[]        @relation("RepairInvoice")
  outboundRelease OutboundRelease? @relation("OrcInvoice")
  reconfigurationWorkOrders ReconfigurationWorkOrder[]

  @@index([clientId], map: "idx_invoices_client")
  @@index([status], map: "idx_invoices_status")
  @@index([invoiceDate], map: "idx_invoices_date")
  @@index([invoiceNumber], map: "idx_invoices_number")
  @@index([clientId, status], map: "idx_invoices_client_status")
  @@index([status, invoiceDate], map: "idx_invoices_status_date")
  @@index([purchaseOrderId], map: "idx_invoices_purchase_order")
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  serialNumberId String?  @map("serial_number_id") @db.Uuid
  description    String
