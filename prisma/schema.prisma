  revokedAt   DateTime? @map("revoked_at")

  createdBy User? @relation("PartnerApiKeyCreator", fields: [createdById], references: [id])

  @@index([keyHash], map: "idx_partner_api_keys_hash")
  @@map("partner_api_keys")
}

