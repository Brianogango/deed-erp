  id                String              @id @default(uuid()) @db.Uuid
  kilimallOrderId   String              @unique @map("kilimall_order_id") @db.VarChar(80)
  kilimallStatus    KilimallOrderStatus @default(pending) @map("kilimall_status")
  internalInvoiceId String?             @map("internal_invoice_id") @db.Uuid
  clientId          String?             @map("client_id") @db.Uuid
  customerName      String?             @map("customer_name") @db.VarChar(200)
  customerPhone     String?             @map("customer_phone") @db.VarChar(30)
  customerEmail     String?             @map("customer_email") @db.VarChar(150)
  shippingAddress   Json?               @map("shipping_address")
  orderDate         DateTime?           @map("order_date")
  subtotal          Decimal?            @db.Decimal(14, 2)
  shippingFee       Decimal             @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  totalAmount       Decimal?            @map("total_amount") @db.Decimal(14, 2)
  paymentMethod     String?             @map("payment_method") @db.VarChar(50)
  isProcessed       Boolean             @default(false) @map("is_processed")
  processedAt       DateTime?           @map("processed_at")
  processedById     String?             @map("processed_by") @db.Uuid
  rawPayload        Json?               @map("raw_payload")
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  internalInvoice Invoice?            @relation(fields: [internalInvoiceId], references: [id])
  client          Client?             @relation(fields: [clientId], references: [id])
  processedBy     User?               @relation(fields: [processedById], references: [id])
  items           KilimallOrderItem[]

  @@index([kilimallStatus], map: "idx_kilimall_orders_status")
  @@index([isProcessed], map: "idx_kilimall_orders_processed")
  @@map("kilimall_orders")
}

model KilimallOrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  kilimallOrderId   String   @map("kilimall_order_id") @db.Uuid
  kilimallListingId String?  @map("kilimall_listing_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  kilimallItemId    String?  @map("kilimall_item_id") @db.VarChar(80)
  productName       String   @map("product_name") @db.VarChar(200)
  qty               Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(14, 2)

  kilimallOrder   KilimallOrder    @relation(fields: [kilimallOrderId], references: [id], onDelete: Cascade)
  kilimallListing KilimallListing? @relation(fields: [kilimallListingId], references: [id])
  product         Product?         @relation(fields: [productId], references: [id])

  @@map("kilimall_order_items")
}

model KilimallSyncLog {
  id            String    @id @default(uuid()) @db.Uuid
  syncType      String    @map("sync_type") @db.VarChar(40)
  status        String    @db.VarChar(20)
  recordsSynced Int       @default(0) @map("records_synced")
  errors        Json?
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  triggeredById String?   @map("triggered_by") @db.Uuid

  triggeredBy User? @relation(fields: [triggeredById], references: [id])

  @@map("kilimall_sync_logs")
}

// ── Outbound Release Checkpoint (ORC) ─────────────────────────────────────────

enum ReleaseStatus {
  pending           // record created; items not yet all picked
  all_picked        // all serials pulled, awaiting authoriser
  verified          // authoriser confirmed serials match source doc
  released          // receiver signed; items left the building
  voided            // cancelled

  @@map("release_status")
}

enum ItemReleaseStatus {
  picked
  verified
  released

  @@map("item_release_status")
}

enum SignatureMethod {
  digital
  paper

  @@map("signature_method")
}

model OutboundRelease {
  id             String        @id @default(uuid()) @db.Uuid
  ref            String        @unique @db.VarChar(30)

  // Source document — exactly one is non-null
  invoiceId      String?       @unique @map("invoice_id") @db.Uuid
  repairId       String?       @unique @map("repair_id") @db.Uuid
  deliveryNoteId String?       @unique @map("delivery_note_id") @db.Uuid

  clientId       String        @map("client_id") @db.Uuid
  status         ReleaseStatus @default(pending)

  initiatedById  String        @map("initiated_by") @db.Uuid
  initiatedAt    DateTime      @default(now()) @map("initiated_at")

  verifiedById   String?       @map("verified_by") @db.Uuid
  verifiedAt     DateTime?     @map("verified_at")

  receivedBy     String?       @map("received_by") @db.VarChar(150)
  receivedByPhone String?      @map("received_by_phone") @db.VarChar(20)
  releaseNotes   String?       @map("release_notes") @db.Text
  conditionOnRelease String?   @map("condition_on_release") @db.Text

  // Receiver signature (customer / courier)
  receiverSigData   String?         @map("receiver_sig_data") @db.Text
  receiverSigMethod SignatureMethod? @map("receiver_sig_method")
  receiverSigRef    String?         @map("receiver_sig_ref") @db.VarChar(200)

  // Authoriser sign-off (identity+timestamp default; drawn sig optional)
  releaserSigData   String?         @map("releaser_sig_data") @db.Text
  releaserSigMethod SignatureMethod? @map("releaser_sig_method")
  releaserSigRef    String?         @map("releaser_sig_ref") @db.VarChar(200)

  // Repairs only — customer acknowledges device received and accepts work
  customerAckSigData   String?         @map("customer_ack_sig_data") @db.Text
  customerAckSigMethod SignatureMethod? @map("customer_ack_sig_method")
  customerAckSigRef    String?         @map("customer_ack_sig_ref") @db.VarChar(200)

  releasedAt     DateTime?     @map("released_at")
  voidedById     String?       @map("voided_by") @db.Uuid
  voidedAt       DateTime?     @map("voided_at")
  voidReason     String?       @map("void_reason")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  invoice      Invoice?           @relation("OrcInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  repair       Repair?            @relation("OrcRepair", fields: [repairId], references: [id], onDelete: SetNull)
  deliveryNote DeliveryNote?      @relation("OrcDelivery", fields: [deliveryNoteId], references: [id], onDelete: SetNull)
  client       Client             @relation("OrcClient", fields: [clientId], references: [id])
  initiatedBy  User               @relation("OrcInitiator", fields: [initiatedById], references: [id])
  verifiedBy   User?              @relation("OrcVerifier", fields: [verifiedById], references: [id])
  voidedBy     User?              @relation("OrcVoider", fields: [voidedById], references: [id])
  items        OutboundReleaseItem[]
  auditLog     OutboundReleaseLog[]

  @@index([invoiceId],    map: "idx_orc_invoice")
  @@index([repairId],     map: "idx_orc_repair")
  @@index([clientId],     map: "idx_orc_client")
  @@index([verifiedById], map: "idx_orc_verifier")
  @@index([status],       map: "idx_orc_status")
  @@index([initiatedAt],  map: "idx_orc_date")
  @@map("outbound_releases")
}

model OutboundReleaseItem {
  id             String            @id @default(uuid()) @db.Uuid
  releaseId      String            @map("release_id") @db.Uuid
  serialNumberId String            @map("serial_number_id") @db.Uuid
  expectedSerial String            @map("expected_serial") @db.VarChar(100)
  confirmedSerial String?          @map("confirmed_serial") @db.VarChar(100)
  serialMatched  Boolean?          @map("serial_matched")
  status         ItemReleaseStatus @default(picked)
  verifiedById   String?           @map("verified_by") @db.Uuid
  verifiedAt     DateTime?         @map("verified_at")

  release      OutboundRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  serialNumber SerialNumber    @relation("SerialOrcItems", fields: [serialNumberId], references: [id])
  verifiedBy   User?           @relation("OrcItemVerifier", fields: [verifiedById], references: [id])

  @@index([releaseId],      map: "idx_orc_items_release")
  @@index([serialNumberId], map: "idx_orc_items_serial")
  @@map("outbound_release_items")
}

model OutboundReleaseLog {
  id            String   @id @default(uuid()) @db.Uuid
  releaseId     String   @map("release_id") @db.Uuid
  action        String   @db.VarChar(50)
  fromStatus    String?  @map("from_status") @db.VarChar(30)
  toStatus      String?  @map("to_status") @db.VarChar(30)
  performedById String   @map("performed_by") @db.Uuid
  performedAt   DateTime @default(now()) @map("performed_at")
  notes         String?
  metadata      Json?

  release     OutboundRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  performedBy User            @relation("OrcLogActor", fields: [performedById], references: [id])

  @@index([releaseId],     map: "idx_orc_log_release")
  @@index([performedAt],   map: "idx_orc_log_date")
  @@index([performedById], map: "idx_orc_log_actor")
  @@map("outbound_release_log")
}

// ── JARVIS AI layer ──────────────────────────────────────────────────────────
// Purely additive: no existing model above this line is modified. userId /
// actor references are plain UUID columns (FK enforced at the DB level via
// the migration SQL, not via a Prisma @relation) so this block never touches
// the User model's relation list.

model AiConversation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  title      String?   @db.VarChar(200)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  messages AiMessage[]

  @@index([userId], map: "idx_ai_conversations_user")
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String   @db.VarChar(20) // user | assistant | tool
  content        String
  toolName       String?  @map("tool_name") @db.VarChar(100)
  toolInput      Json?    @map("tool_input")
  toolOutput     Json?    @map("tool_output")
  citedSources   Json?    @map("cited_sources")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "idx_ai_messages_conversation")
  @@map("ai_messages")
}

model AiAuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  conversationId    String?  @map("conversation_id") @db.Uuid
  toolName          String   @map("tool_name") @db.VarChar(100)
  permissionChecked String   @map("permission_checked") @db.VarChar(100)
  allowed           Boolean
  inputParams       Json?    @map("input_params")
  resultMeta        Json?    @map("result_meta")
  errorMessage      String?  @map("error_message")
  durationMs        Int?     @map("duration_ms")
  ipAddress         String?  @map("ip_address")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId],    map: "idx_ai_audit_user")
  @@index([toolName],  map: "idx_ai_audit_tool")
  @@index([createdAt], map: "idx_ai_audit_date")
  @@map("ai_audit_logs")
}

model AiDocument {
  id         String   @id @default(uuid()) @db.Uuid
  sourceType String   @map("source_type") @db.VarChar(30) // 'sop' | 'my_document'
  sourceId   String   @map("source_id") @db.VarChar(100)
  title      String   @db.VarChar(300)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  checksum   String   @db.VarChar(64)
  status     String   @default("ready") @db.VarChar(20) // ready | unsupported | failed
  ingestedAt DateTime @default(now()) @map("ingested_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  chunks AiDocumentChunk[]

  @@unique([sourceType, sourceId], map: "uq_ai_documents_source")
  @@map("ai_documents")
}

model AiDocumentChunk {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  chunkIndex  Int      @map("chunk_index")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId], map: "idx_ai_document_chunks_document")
  @@map("ai_document_chunks")
}
