model Invoice {
  id             String         @id @default(uuid()) @db.Uuid
  invoiceNumber  String         @unique @map("invoice_number") @db.VarChar(30)
  clientId       String         @map("client_id") @db.Uuid
  quoteId        String?        @map("quote_id") @db.Uuid
  saleOrderId    String?        @map("sale_order_id") @db.Uuid
  repairId       String?        @map("repair_id") @db.Uuid
  assignedToId   String?        @map("assigned_to") @db.Uuid
  status         DocumentStatus @default(draft)
  invoiceDate    DateTime       @default(now()) @map("invoice_date") @db.Date
  dueDate        DateTime?      @map("due_date") @db.Date
  subject        String?        @db.VarChar(200)
  subtotal       Decimal        @default(0) @db.Decimal(14, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  discountPct    Decimal        @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid     Decimal        @default(0) @map("amount_paid") @db.Decimal(14, 2)
  // balanceDue = totalAmount - amountPaid — compute in application
  notes          String?
  internalNotes  String?        @map("internal_notes")
  terms          String?
  isPosInvoice   Boolean        @default(false) @map("is_pos_invoice")
  approvedById   String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at")
  createdById    String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  client          Client          @relation(fields: [clientId], references: [id])
  quote           Quote?          @relation("InvoiceSourceQuote", fields: [quoteId], references: [id])
  repair          Repair?         @relation("InvoiceRepair", fields: [repairId], references: [id], onDelete: SetNull)
  assignedTo      User?           @relation("InvoiceAssignee", fields: [assignedToId], references: [id])
  approvedBy      User?           @relation("InvoiceApprover", fields: [approvedById], references: [id])
  createdBy       User            @relation("InvoiceCreator", fields: [createdById], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  creditNotes     CreditNote[]    @relation("CreditNoteInvoice")
  creditApplied   CreditNote[]    @relation("CreditNoteApplied")
  deliveries      DeliveryNote[]
  posTransactions PosTransaction[]
  kilimallOrders  KilimallOrder[]
  quotesConverted Quote[]         @relation("QuoteConvertedTo")
  saleOrders      SaleOrder[]     @relation("InvoiceSourceSaleOrder")
  serialsSold     SerialNumber[]  @relation("SerialSoldInvoice")
  commissions     SalesCommission[] @relation("CommissionInvoice")
  repairs         Repair[]        @relation("RepairInvoice")
  outboundRelease OutboundRelease? @relation("OrcInvoice")

  @@index([clientId], map: "idx_invoices_client")
  @@index([status], map: "idx_invoices_status")
  @@index([invoiceDate], map: "idx_invoices_date")
  @@index([invoiceNumber], map: "idx_invoices_number")
  @@map("invoices")
}

