// Deed ERP — Full Prisma Schema (PostgreSQL)
// npx prisma generate | npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  finance
  inventory
  kilimall
  technician
  sales
  director
  admin_officer
  finance_officer
  inventory_officer
  kilimall_officer
  sales_rep
  technical_lead
  super_admin
  lead_tech
  repair_tech
  release_authoriser

  @@map("user_role")
}

enum ProductType {
  new
  refurbished

  @@map("product_type")
}

enum TrackingMethod {
  NONE
  QUANTITY
  BATCH
  SERIAL

  @@map("tracking_method")
}

enum ConditionGrade {
  A
  B
  C
  parts_only

  @@map("condition_grade")
}

enum StockMovementType {
  purchase_receive
  sale
  repair_use
  adjustment_in
  adjustment_out
  return_from_client
  return_to_supplier
  transfer
  write_off
  opening_stock
  // Device reconfiguration: a component physically removed from a device
  // returning to bulk stock (pending_testing/quarantine), or a component
  // consumed from bulk stock to install into a device.
  reconfiguration_in
  reconfiguration_out

  @@map("stock_movement_type")
}

enum DocumentStatus {
  draft
  pending_approval
  approved
  rejected
  invoiced
  dispatched
  delivered
  paid
  partially_paid
  cancelled
  voided @map("void")

  @@map("document_status")
}

enum PaymentMethod {
  cash
  mpesa
  bank_transfer
  card
  credit
  cheque

  @@map("payment_method")
}

enum RepairStatus {
  intake
  diagnosis
  awaiting_parts
  in_repair
  qc
  ready
  verified_released
  collected
  cancelled
  unrepairable

  @@map("repair_status")
}

enum DeliveryMethod {
  pickup
  courier
  own_delivery

  @@map("delivery_method")
}

enum LeaveType {
  annual
  sick
  maternity
  paternity
  compassionate
  unpaid
  study
  december_closure

  @@map("leave_type")
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
  pending_hr

  @@map("leave_status")
}

model LeavePolicy {
  id                  String   @id @default(uuid()) @db.Uuid
  effectiveYear       Int      @unique @map("effective_year")
  annualEntitlement   Int      @default(21) @map("annual_entitlement")
  discretionaryDays   Int      @default(13) @map("discretionary_days")
  closureDays         Int      @default(8)  @map("closure_days")
  closureStartMmDd    String   @default("12-23") @map("closure_start_mm_dd") @db.VarChar(5)
  closureEndMmDd      String   @default("01-02") @map("closure_end_mm_dd")   @db.VarChar(5)
  sickFullPayDays     Int      @default(7)  @map("sick_full_pay_days")
  sickHalfPayDays     Int      @default(7)  @map("sick_half_pay_days")
  maternityDays       Int      @default(90) @map("maternity_days")
  paternityDays       Int      @default(14) @map("paternity_days")
  compassionateDays   Int      @default(5)  @map("compassionate_days")
  studyDays           Int      @default(5)  @map("study_days")
  noticeShortDays     Int      @default(5)  @map("notice_short_days")
  noticeLongDays      Int      @default(14) @map("notice_long_days")
  noticeThreshold     Int      @default(3)  @map("notice_threshold")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("leave_policies")
}

enum KilimallOrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
  refunded

  @@map("kilimall_order_status")
}

enum TaxType {
  vat
  exempt
  zero_rated
  out_of_scope
  non_vat_supplier
  not_selected

  @@map("tax_type")
}

// Matches the client-side POStatus vocabulary exactly (lib/store.tsx) — no
// unused code depended on the old draft/pending_approval/approved/
// partially_received wording, so this redefines rather than adds aliases.
enum PurchaseOrderStatus {
  draft
  sent
  confirmed
  partial
  received
  cancelled

  @@map("purchase_order_status")
}

// ── System / Auth ──────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String?   @unique @map("employee_id") @db.Uuid
  username     String    @unique @db.VarChar(60)
  email        String    @unique @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  passwordHash String    @map("password_hash")
  role         UserRole  @default(sales)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  mustResetPw  Boolean   @default(false) @map("must_reset_pw")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdById  String?   @map("created_by") @db.Uuid

  employee     Employee? @relation("UserEmployee", fields: [employeeId], references: [id])
  createdBy    User?     @relation("UserSelf", fields: [createdById], references: [id])
  createdUsers User[]    @relation("UserSelf")
  opportunitiesCreated Opportunity[] @relation("OpportunityOwner")
  opportunityAssignments Opportunity[] @relation("OpportunityAssignee")
  leadsOwned           Lead[]          @relation("LeadOwner")
  opportunityActivitiesCreated OpportunityActivity[] @relation("OpportunityActivityCreator")
  saleOrders           SaleOrder[] @relation("SaleOrderCreator")

  sessions             UserSession[]
  auditLogs            AuditLog[]
  settingUpdates       CompanySetting[]
  integrationUpdates   Integration[]
  employeeCreations    Employee[]                  @relation("EmployeeCreator")
  leaveReviews         LeaveRequest[]              @relation("LeaveReviewer")
  attendanceRecorded   AttendanceRecord[]          @relation("AttendanceRecorder")
  payrollApprovals     PayrollRun[]                @relation("PayrollApprover")
  payrollCreations     PayrollRun[]                @relation("PayrollCreator")
  loanCreations        EmployeeLoan[]
  clientCreations      Client[]
  supplierCreations    Supplier[]
  productValidations   Product[]                   @relation("ProductValidator")
  productCreations     Product[]                   @relation("ProductCreator")
  partnerApiKeys       PartnerApiKey[]             @relation("PartnerApiKeyCreator")
  stockMovements       StockMovement[]
  adjApprovals         StockAdjustment[]           @relation("AdjApprover")
  adjCreations         StockAdjustment[]           @relation("AdjCreator")
  poApprovals          PurchaseOrder[]             @relation("POApprover")
  poCreations          PurchaseOrder[]             @relation("POCreator")
  grnCreations         GoodsReceivedNote[]
  supplierPayments     SupplierPayment[]
  quoteAssignments     Quote[]                     @relation("QuoteAssignee")
  quoteApprovals       Quote[]                     @relation("QuoteApprover")
  quoteCreations       Quote[]                     @relation("QuoteCreator")
  invoiceAssignments   Invoice[]                   @relation("InvoiceAssignee")
  invoiceApprovals     Invoice[]                   @relation("InvoiceApprover")
  invoiceCreations     Invoice[]                   @relation("InvoiceCreator")
  paymentCreations     Payment[]                   @relation("PaymentCreator")
  paymentVoids         Payment[]                   @relation("PaymentVoider")
  creditNoteCreations  CreditNote[]
  deliveryDispatches   DeliveryNote[]              @relation("DeliveryDispatcher")
  deliveryCreations    DeliveryNote[]              @relation("DeliveryCreator")
  deliveryPreparations DeliveryNote[]              @relation("DeliveryPreparer")
  deliveryNoteGenerations DeliveryNote[]           @relation("DeliveryNoteGenerator")
  repairAssignments    Repair[]                    @relation("RepairTech")
  repairCreations      Repair[]                    @relation("RepairCreator")
  repairStageChanges   RepairStage[]
  repairPartAdditions  RepairPart[]
  repairDiagnostics    RepairDiagnostic[]
  repairComms          RepairClientCommunication[]
  posSessions          PosSession[]
  posTransactions      PosTransaction[]
  kilimallListings     KilimallListing[]
  orcInitiations       OutboundRelease[]           @relation("OrcInitiator")
  orcVerifications     OutboundRelease[]           @relation("OrcVerifier")
  orcVoids             OutboundRelease[]           @relation("OrcVoider")
  orcItemVerifications OutboundReleaseItem[]       @relation("OrcItemVerifier")
  orcLogActions        OutboundReleaseLog[]        @relation("OrcLogActor")
  kilimallOrderProcs   KilimallOrder[]
  kilimallSyncLogs     KilimallSyncLog[]
  labelPrintJobs       LabelPrintJob[]
  reconfigRequested    ReconfigurationWorkOrder[] @relation("ReconfigRequester")
  reconfigTechnician   ReconfigurationWorkOrder[] @relation("ReconfigTechnician")
  reconfigApprover     ReconfigurationWorkOrder[] @relation("ReconfigApprover")
  reconfigQaOfficer    ReconfigurationWorkOrder[] @relation("ReconfigQaOfficer")
  reconfigCreated      ReconfigurationWorkOrder[] @relation("ReconfigCreator")
  reconfigUpdated      ReconfigurationWorkOrder[] @relation("ReconfigUpdater")
  reconfigApprovals    ReconfigurationApproval[]
  reconfigQaChecks     ReconfigurationQaCheck[]
  reconfigAttachments  ReconfigurationAttachment[]
  deviceSerialCostUpdates DeviceSerialCost[]
  configSnapshotsCreated DeviceConfigurationSnapshot[]
  installationsInstalled DeviceComponentInstallation[] @relation("InstallationInstaller")
  installationsRemoved   DeviceComponentInstallation[] @relation("InstallationRemover")
  reconfigRemovalsPerformed ReconfigurationRemovalLine[]
  reconfigInstallsPerformed ReconfigurationInstallationLine[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  entityKey  String?  @map("entity_key") @db.VarChar(120)
  requestId  String?  @map("request_id") @db.VarChar(120)
  monetaryHash String? @map("monetary_hash") @db.VarChar(128)
  relatedJournalId String? @map("related_journal_id") @db.Uuid
  approvalReason String? @map("approval_reason") @db.VarChar(500)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_audit_user")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_date")
  @@map("audit_logs")
}

/// Long-term archive for store-sync timeline rows displaced from the live
/// `deed_audit_timeline_v1` blob (P0-SEC-002). Additive only — never drops live rows.
model StoreAuditArchive {
  id        String   @id @default(cuid())
  entryId   String   @map("entry_id") @db.VarChar(80)
  at        DateTime @map("at")
  actorId   String?  @map("actor_id") @db.VarChar(80)
  actorName String?  @map("actor_name") @db.VarChar(200)
  actorRole String?  @map("actor_role") @db.VarChar(60)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([at], map: "idx_store_audit_archive_at")
  @@index([entryId], map: "idx_store_audit_archive_entry")
  @@map("store_audit_archive")
}

// ── Settings ───────────────────────────────────────────────────────────────────

model CompanySetting {
  id                String   @id @default(uuid()) @db.Uuid
  companyName       String   @default("Deed Technologies") @map("company_name") @db.VarChar(200)
  tradeName         String?  @map("trade_name") @db.VarChar(200)
  kraPin            String?  @map("kra_pin") @db.VarChar(20)
  vatNumber         String?  @map("vat_number") @db.VarChar(30)
  addressLine1      String?  @map("address_line1")
  addressLine2      String?  @map("address_line2")
  city              String?  @default("Nairobi") @db.VarChar(100)
  country           String?  @default("Kenya") @db.VarChar(100)
  phone             String?  @db.VarChar(20)
  email             String?  @db.VarChar(150)
  website           String?  @db.VarChar(200)
  logoUrl           String?  @map("logo_url")
  defaultCurrency   String   @default("KES") @map("default_currency") @db.VarChar(10)
  defaultVatRate    Decimal  @default(16.00) @map("default_vat_rate") @db.Decimal(5, 2)
  invoicePrefix     String   @default("INV") @map("invoice_prefix") @db.VarChar(10)
  quotePrefix       String   @default("QT") @map("quote_prefix") @db.VarChar(10)
  purchasePrefix    String   @default("PO") @map("purchase_prefix") @db.VarChar(10)
  repairPrefix      String   @default("RPR") @map("repair_prefix") @db.VarChar(10)
  invoiceSeq        Int      @default(1) @map("invoice_seq")
  quoteSeq          Int      @default(1) @map("quote_seq")
  purchaseSeq       Int      @default(1) @map("purchase_seq")
  repairSeq         Int      @default(1) @map("repair_seq")
  invoiceFooterNote String?  @map("invoice_footer_note")
  quoteValidityDays Int?     @default(7) @map("quote_validity_days")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedById       String?  @map("updated_by") @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("company_settings")
}

model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(60)
  rate      Decimal  @db.Decimal(5, 2)
  taxType   TaxType  @default(vat) @map("tax_type")
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("tax_rates")
}

model DocumentTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  type      String   @db.VarChar(40)
  bodyHtml  String?  @map("body_html")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("document_templates")
}

model NotificationTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  triggerEvent String   @map("trigger_event") @db.VarChar(80)
  channel      String   @db.VarChar(20)
  subject      String?  @db.VarChar(200)
  body         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("notification_templates")
}

model Integration {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(60)
  config       Json      @default("{}")
  isActive     Boolean   @default(false) @map("is_active")
  lastTestedAt DateTime? @map("last_tested_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedById  String?   @map("updated_by") @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("integrations")
}

// ── HR ─────────────────────────────────────────────────────────────────────────

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(100)
  description String?
  isActive    Boolean    @default(true) @map("is_active")

  employees Employee[]

  @@map("departments")
}

model Employee {
  id               String    @id @default(uuid()) @db.Uuid
  employeeNumber   String    @unique @map("employee_number") @db.VarChar(20)
  firstName        String    @map("first_name") @db.VarChar(80)
  lastName         String    @map("last_name") @db.VarChar(80)
  idNumber         String?   @unique @map("id_number") @db.VarChar(20)
  kraPin           String?   @map("kra_pin") @db.VarChar(20)
  nhifNumber       String?   @map("nhif_number") @db.VarChar(20)
  nssfNumber       String?   @map("nssf_number") @db.VarChar(20)
  shift            String?   @db.VarChar(50)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String?   @db.VarChar(10)
  phone            String?   @db.VarChar(20)
  email            String?   @db.VarChar(150)
  address          String?
  departmentId     String?   @map("department_id") @db.Uuid
  jobTitle         String?   @map("job_title") @db.VarChar(100)
  employmentType   String    @default("full_time") @map("employment_type") @db.VarChar(30)
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  basicSalary      Decimal   @default(0) @map("basic_salary") @db.Decimal(12, 2)
  paymentMode      String    @default("mpesa") @map("payment_mode") @db.VarChar(20)
  bankName         String?   @map("bank_name") @db.VarChar(100)
  bankAccount      String?   @map("bank_account") @db.VarChar(50)
  mpesaNumber      String?   @map("mpesa_number") @db.VarChar(20)
  annualLeaveDays  Int       @default(21) @map("annual_leave_days")
  sickLeaveDays    Int       @default(10) @map("sick_leave_days")
  emergencyContact Json?     @map("emergency_contact")
  isActive         Boolean   @default(true) @map("is_active")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdById      String?   @map("created_by") @db.Uuid

  department    Department?        @relation(fields: [departmentId], references: [id])
  createdBy     User?              @relation("EmployeeCreator", fields: [createdById], references: [id])
  user          User?              @relation("UserEmployee")
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  attendance    AttendanceRecord[]
  payslips      Payslip[]
  loans         EmployeeLoan[]
  salaryAdvances SalaryAdvance[]
  commissions   SalesCommission[]

  @@index([departmentId], map: "idx_employees_department")
  @@map("employees")
}

model LeaveRequest {
  id            String      @id @default(uuid()) @db.Uuid
  reference     String?     @unique @map("reference") @db.VarChar(40)
  employeeId    String      @map("employee_id") @db.Uuid
  employeeName  String?     @map("employee_name") @db.VarChar(160)
  leaveType     LeaveType   @map("leave_type")
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  daysRequested Decimal     @map("days_requested") @db.Decimal(4, 1)
  reason        String?
  status        LeaveStatus @default(pending_hr)
  reviewedById  String?     @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?   @map("reviewed_at")
  reviewNotes   String?     @map("review_notes")
  reviewedByName String?    @map("reviewed_by_name") @db.VarChar(160)
  submittedByUserId String? @map("submitted_by_user_id") @db.Uuid
  isSystemGenerated Boolean @default(false) @map("is_system_generated")
  createdAt     DateTime    @default(now()) @map("created_at")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([employeeId], map: "idx_leave_requests_employee")
  @@map("leave_requests")
}

model LeaveBalance {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  leaveType    LeaveType @map("leave_type")
  year         Int
  entitlement  Decimal  @default(0) @db.Decimal(5, 1)
  carryForward Decimal  @default(0) @map("carry_forward") @db.Decimal(5, 1)
  used         Decimal  @default(0) @db.Decimal(5, 1)
  pending      Decimal  @default(0) @db.Decimal(5, 1)
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, year], map: "uq_leave_balance_emp_type_year")
  @@index([employeeId], map: "idx_leave_balances_employee")
  @@map("leave_balances")
}

model AttendanceRecord {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  workDate      DateTime  @map("work_date") @db.Date
  clockIn       DateTime? @map("clock_in")
  clockOut      DateTime? @map("clock_out")
  hoursWorked   Decimal?  @map("hours_worked") @db.Decimal(4, 2)
  isOvertime    Boolean   @default(false) @map("is_overtime")
  overtimeHours Decimal   @default(0) @map("overtime_hours") @db.Decimal(4, 2)
  notes         String?
  recordedById  String?   @map("recorded_by") @db.Uuid

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([employeeId, workDate])
  @@index([employeeId, workDate], map: "idx_attendance_employee_date")
  @@map("attendance_records")
}

model PayrollRun {
  id           String    @id @default(uuid()) @db.Uuid
  runReference String    @unique @map("run_reference") @db.VarChar(30)
  periodStart  DateTime  @map("period_start") @db.Date
  periodEnd    DateTime  @map("period_end") @db.Date
  runDate      DateTime  @map("run_date") @db.Date
  periodMonth  String?   @map("period_month") @db.VarChar(20)
  periodYear   Int?      @map("period_year")
  status       String    @default("draft") @db.VarChar(20)
  totalGross   Decimal   @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalPaye    Decimal   @default(0) @map("total_paye") @db.Decimal(14, 2)
  totalNhif    Decimal   @default(0) @map("total_nhif") @db.Decimal(14, 2)
  totalNssf    Decimal   @default(0) @map("total_nssf") @db.Decimal(14, 2)
  totalShif    Decimal   @default(0) @map("total_shif") @db.Decimal(14, 2)
  totalHousingLevy Decimal @default(0) @map("total_housing_levy") @db.Decimal(14, 2)
  totalEmployerContributions Decimal @default(0) @map("total_employer_contributions") @db.Decimal(14, 2)
  statutoryRuleVersionId String? @map("statutory_rule_version_id") @db.Uuid
  postedById String? @map("posted_by_id") @db.Uuid
  postedAt DateTime? @map("posted_at")
  postingStatus String @default("unposted") @map("posting_status") @db.VarChar(20)
  totalDeductions Decimal @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet     Decimal   @default(0) @map("total_net") @db.Decimal(14, 2)
  postedJournalId String? @map("posted_journal_id") @db.Uuid
  notes        String?
  approvedById String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  approvedBy       User?             @relation("PayrollApprover", fields: [approvedById], references: [id])
  createdBy        User?             @relation("PayrollCreator", fields: [createdById], references: [id])
  payslips         Payslip[]
  salesCommissions SalesCommission[]

  @@map("payroll_runs")
}

model Payslip {
  id                 String    @id @default(uuid()) @db.Uuid
  payrollRunId       String    @map("payroll_run_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  basicSalary        Decimal   @map("basic_salary") @db.Decimal(12, 2)
  houseAllowance     Decimal   @default(0) @map("house_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal   @default(0) @map("transport_allowance") @db.Decimal(12, 2)
  commission         Decimal   @default(0) @db.Decimal(12, 2)
  overtimePay        Decimal   @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  otherAdditions     Decimal   @default(0) @map("other_additions") @db.Decimal(12, 2)
  grossPay           Decimal   @map("gross_pay") @db.Decimal(12, 2)
  paye               Decimal   @default(0) @db.Decimal(12, 2)
