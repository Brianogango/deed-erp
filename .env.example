
# JARVIS AI assistant (read-only ERP Q&A + draft generation — no autonomous sends)
# Provider switch: gemini (default, cost-efficient Flash) | anthropic
JARVIS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional Anthropic fallback when JARVIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Public marketing site for JARVIS knowledge ingest (WordPress REST)
DEED_WEBSITE_URL=https://deed.africa

# Finance Phase 1 — central posting engine. Production must be true so expense,
# POS, bank recon, outstanding receipts, and STK journals actually post.
ACCOUNTING_POSTING_ENGINE=true

# Finance Phase 2 — outstanding receipts/payments use clearing accounts 1805/3005 when the posting engine is on

# Email Integration
# Provider options: sendgrid | ses | smtp
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@deed.co.ke

# SendGrid
SENDGRID_API_KEY=

# AWS SES
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional mailbox profiles used by ERP messaging.
# If these are blank, the system falls back to SMTP_USER/SMTP_PASS and EMAIL_FROM.
HR_EMAIL=hr@deed.co.ke
HR_SMTP_USER=
HR_SMTP_PASS=
# Leave apply: To = HR_TEAM_EMAIL (default hr@deed.co.ke). CC = Edwin + Dennis only.
HR_TEAM_EMAIL=hr@deed.co.ke
LEAVE_APPLY_CC_EMAILS=edwin@deed.co.ke,dennis@deed.co.ke
SALES_EMAIL=sales@deed.co.ke
SALES_SMTP_USER=
SALES_SMTP_PASS=
# Sales inbox → CRM leads (IMAP). Defaults to SALES_SMTP_* + SMTP_HOST:993 when unset.
# SALES_IMAP_HOST=mail.deed.co.ke
# SALES_IMAP_PORT=993
# SALES_IMAP_USER=sales@deed.co.ke
# SALES_IMAP_PASS=
# SALES_IMAP_MAILBOX=INBOX
# SALES_INBOX_BLOCK_DOMAINS=
# SALES_INBOX_BLOCK_LOCALS=
# Pipeline mode: shadow | review | auto (default auto)
# SALES_INBOX_MODE=auto
# SALES_INBOX_AUTO_CREATE_ENABLED=true
# SALES_INBOX_AUTO_CREATE_THRESHOLD=0.9
# SALES_INBOX_REVIEW_THRESHOLD=0.75
# SALES_INBOX_INTERNAL_DOMAINS=deed.co.ke,deedcomputers.co.ke
# SALES_INBOX_BANK_SENDERS=
# SALES_INBOX_SUPPLIER_SENDERS=
# SALES_INBOX_AI_CLASSIFIER=auto
# SALES_INBOX_GEMINI_MODEL=
# SALES_INBOX_CLASSIFIER_VERSION=
# Protect /api/cron/sales-inbox-leads (Bearer or x-cron-secret)
# CRON_SECRET=
ACCOUNTS_EMAIL=accounts@deed.co.ke
ACCOUNTS_SMTP_USER=
ACCOUNTS_SMTP_PASS=

# WhatsApp Business API (Meta/Facebook)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Twilio (SMS & Alternative WhatsApp Provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Notification Settings
PROCUREMENT_TEAM_PHONE=+254700000000
SALES_TEAM_EMAIL=sales@deed.co.ke

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Customer Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000
CUSTOMER_PORTAL_SECRET=generate-random-secret-for-customer-tokens

# PDF Generation
PDF_LOGO_URL=/logo.png
PDF_COMPANY_NAME=Deed ERP
PDF_COMPANY_ADDRESS=Nairobi, Kenya
PDF_COMPANY_PHONE=+254 700 000000
PDF_COMPANY_EMAIL=info@deed.co.ke


# ── Durable Notification Platform ────────────────────────────────
# Protect /api/cron/notifications. Generate a long random value.
CRON_SECRET=

# Browser Web Push. Generate with: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@deed.co.ke

# Default phone normalization for local numbers.
DEFAULT_PHONE_COUNTRY_CODE=254

# Provider delivery webhooks.
# Meta WhatsApp GET verification token + POST app-secret signature.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Pin/update the Graph API version deliberately during provider maintenance.
WHATSAPP_GRAPH_API_VERSION=v18.0
WHATSAPP_HTTP_TIMEOUT_MS=10000
WHATSAPP_CIRCUIT_FAILURE_THRESHOLD=5
WHATSAPP_CIRCUIT_COOLDOWN_MS=60000

# SendGrid Event Webhook: use signed verification when available.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Optional shared-secret fallback for SendGrid webhook verification.
NOTIFICATION_WEBHOOK_SECRET=

# SMTP transport hardening.
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_RATE_DELTA_MS=1000
SMTP_RATE_LIMIT=8
# Optional when SMTP certificate hostname differs intentionally:
SMTP_TLS_SERVERNAME=

# SMS / bulk delivery controls.
TWILIO_HTTP_TIMEOUT_MS=10000
SMS_MAX_CONCURRENT=2
SMS_MAX_PER_SECOND=1
NOTIFICATION_BATCH_CONCURRENCY=4
