# ── Upstash Redis (rate limiting & caching) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-strong-random-secret

# Email Integration
# Provider options: sendgrid | ses | smtp
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@deed.co.ke

# SendGrid
SENDGRID_API_KEY=

# AWS SES
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# WhatsApp Business API (Meta/Facebook)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Twilio (SMS & Alternative WhatsApp Provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Notification Settings
PROCUREMENT_TEAM_PHONE=+254700000000
SALES_TEAM_EMAIL=sales@deed.co.ke

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
