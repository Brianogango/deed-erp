
# Email Integration
# Provider options: sendgrid | ses | smtp
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@deed.co.ke

# SendGrid
SENDGRID_API_KEY=

# AWS SES
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional mailbox profiles used by ERP messaging.
# If these are blank, the system falls back to SMTP_USER/SMTP_PASS and EMAIL_FROM.
HR_EMAIL=hr@deed.co.ke
HR_SMTP_USER=
HR_SMTP_PASS=
SALES_EMAIL=sales@deed.co.ke
SALES_SMTP_USER=
SALES_SMTP_PASS=
ACCOUNTS_EMAIL=accounts@deed.co.ke
ACCOUNTS_SMTP_USER=
ACCOUNTS_SMTP_PASS=

# WhatsApp Business API (Meta/Facebook)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Twilio (SMS & Alternative WhatsApp Provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Notification Settings
PROCUREMENT_TEAM_PHONE=+254700000000
SALES_TEAM_EMAIL=sales@deed.co.ke

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Customer Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000
CUSTOMER_PORTAL_SECRET=generate-random-secret-for-customer-tokens

# PDF Generation
PDF_LOGO_URL=/logo.png
PDF_COMPANY_NAME=Deed ERP
PDF_COMPANY_ADDRESS=Nairobi, Kenya
PDF_COMPANY_PHONE=+254 700 000000
PDF_COMPANY_EMAIL=info@deed.co.ke
