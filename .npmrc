# pnpm is the supported package manager for this project (see `packageManager`
# in package.json). These settings only matter if someone runs npm ad hoc;
# `npm ci` is no longer possible because there is deliberately no
# package-lock.json — a second lockfile drifts from the one CI installs from.
#
# legacy-peer-deps: nodemailer 9 does not satisfy next-auth's optional peer
# range of ^7, and npm treats that as a conflict. The lockfile was already
# resolved past it.
#
# allow-remote: xlsx is installed from the SheetJS CDN, not the npm registry
# (https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz), so npm classes it as a
# "remote" package. npm 12 made the default for those "none". "root" allows
# this project's own direct dependencies and nothing deeper, rather than
# opening remote fetches for the whole tree.
#
# The CDN tarball is integrity-pinned in pnpm-lock.yaml
# (sha512-oLDq3jw7AcLq...), so its *contents* cannot drift; the only exposure is
# cdn.sheetjs.com being unreachable at install time. The npm-registry `xlsx` is
# a deprecated 0.18.5, so moving to it would be a downgrade — hence the pin
# stays. A build host or sandbox must allow cdn.sheetjs.com.
legacy-peer-deps=true
allow-remote=root
